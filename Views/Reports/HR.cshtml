@{
    var employees = ((ViewBag.Employees as IEnumerable<Employee>)?.ToList() ?? new List<Employee>());
    decimal totalPayroll = ViewBag.TotalPayroll;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <a asp-action="Index" class="btn btn-sm btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i>All Reports</a>
    <button onclick="window.print()" class="btn btn-sm btn-outline-primary"><i class="bi bi-printer me-1"></i>Print</button>
</div>

<div class="row g-3 mb-4">
    <div class="col-6 col-md-3"><div class="kpi-card">
        <div class="kpi-label">Total Employees</div><div class="kpi-value">@employees.Count</div>
    </div></div>
    <div class="col-6 col-md-3"><div class="kpi-card">
        <div class="kpi-label">On Duty</div>
        <div class="kpi-value text-success">@ViewBag.OnDuty</div>
    </div></div>
    <div class="col-6 col-md-3"><div class="kpi-card">
        <div class="kpi-label">On Leave</div>
        <div class="kpi-value text-warning">@(employees.Count - (int)ViewBag.OnDuty)</div>
    </div></div>
    <div class="col-6 col-md-3"><div class="kpi-card">
        <div class="kpi-label">Monthly Payroll</div>
        <div class="kpi-value">৳@totalPayroll.ToString("N0")</div>
    </div></div>
</div>

<div class="row g-4 mb-4">
    <div class="col-md-6">
        <div class="card">
            <div class="card-header"><h6>Payroll by Farm</h6></div>
            <div class="table-responsive">
                <table class="table mb-0">
                    <thead><tr><th>Farm</th><th>Headcount</th><th>Monthly Payroll</th></tr></thead>
                    <tbody>
                        @foreach (var g in employees.GroupBy(e => e.FarmName ?? "All Farms").Select(g => new { Farm = g.Key, Count = g.Count(), Payroll = g.Sum(e => e.MonthlySalary) }))
                        {
                            <tr>
                                <td><strong>@g.Farm</strong></td>
                                <td>@g.Count</td>
                                <td class="fw-semibold">৳@g.Payroll.ToString("N0")</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot class="table-light fw-bold">
                        <tr><td>Total</td><td>@employees.Count</td><td>৳@totalPayroll.ToString("N0")</td></tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card">
            <div class="card-header"><h6>Staff by Role</h6></div>
            <div class="table-responsive">
                <table class="table mb-0">
                    <thead><tr><th>Role</th><th>Count</th><th>Avg Salary</th></tr></thead>
                    <tbody>
                        @foreach (var g in employees.GroupBy(e => e.Role).OrderByDescending(g => g.Count()))
                        {
                            <tr>
                                <td>@g.Key</td>
                                <td>@g.Count()</td>
                                <td class="text-muted">৳@g.Average(e => e.MonthlySalary).ToString("N0")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-header"><h6><i class="bi bi-people-fill text-primary me-2"></i>Full Employee List</h6></div>
    <div class="table-responsive">
        <table class="table mb-0" style="font-size:12px">
            <thead><tr><th>#</th><th>Name</th><th>Role</th><th>Farm</th><th>Phone</th><th>Join Date</th><th>Salary (৳)</th><th>Status</th></tr></thead>
            <tbody>
                @{ int rowNum = 1; }
                @foreach (var e in employees)
                {
                    <tr>
                        <td class="text-muted">@rowNum</td>
                        <td><strong>@e.FullName</strong></td>
                        <td>@e.Role</td>
                        <td><small class="text-muted">@(e.FarmName ?? "All Farms")</small></td>
                        <td><small>@(e.Phone ?? "—")</small></td>
                        <td><small class="text-muted">@e.JoinDate.ToString("dd MMM yyyy")</small></td>
                        <td class="fw-semibold">৳@e.MonthlySalary.ToString("N0")</td>
                        <td><span class="badge @(e.Status=="On Duty"?"badge-healthy":"badge-warning-soft")">@e.Status</span></td>
                    </tr>
                    rowNum++;
                }
            </tbody>
            <tfoot class="table-light fw-bold">
                <tr><td colspan="6">Total Payroll</td><td>৳@totalPayroll.ToString("N0")</td><td></td></tr>
            </tfoot>
        </table>
    </div>
</div>
