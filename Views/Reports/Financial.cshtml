@{
    var trend = ((ViewBag.Trend as IEnumerable<MonthlyFinancial>)?.ToList() ?? new List<MonthlyFinancial>());
    var transactions = ((ViewBag.Transactions as IEnumerable<Transaction>)?.ToList() ?? new List<Transaction>());
    decimal revenue = ViewBag.MonthlyRevenue;
    decimal expenses = ViewBag.MonthlyExpenses;
    decimal profit = ViewBag.NetProfit;
    decimal margin = ViewBag.ProfitMargin;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <a asp-action="Index" class="btn btn-sm btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i>All Reports</a>
    <button onclick="window.print()" class="btn btn-sm btn-outline-primary"><i class="bi bi-printer me-1"></i>Print</button>
</div>

<div class="row g-3 mb-4">
    <div class="col-6 col-md-3"><div class="kpi-card">
        <div class="kpi-label">Revenue (This Month)</div>
        <div class="kpi-value text-success">৳@revenue.ToString("N0")</div>
    </div></div>
    <div class="col-6 col-md-3"><div class="kpi-card">
        <div class="kpi-label">Expenses (This Month)</div>
        <div class="kpi-value text-danger">৳@expenses.ToString("N0")</div>
    </div></div>
    <div class="col-6 col-md-3"><div class="kpi-card">
        <div class="kpi-label">Net Profit</div>
        <div class="kpi-value @(profit >= 0 ? "text-success" : "text-danger")">৳@profit.ToString("N0")</div>
    </div></div>
    <div class="col-6 col-md-3"><div class="kpi-card">
        <div class="kpi-label">Profit Margin</div>
        <div class="kpi-value">@margin.ToString("F1")%</div>
    </div></div>
</div>

<div class="card mb-4">
    <div class="card-header"><h6><i class="bi bi-table text-primary me-2"></i>Monthly P&L Summary</h6></div>
    <div class="table-responsive">
        <table class="table mb-0">
            <thead><tr><th>Month</th><th>Year</th><th>Revenue (৳)</th><th>Expenses (৳)</th><th>Net Profit (৳)</th><th>Margin</th></tr></thead>
            <tbody>
                @foreach (var m in trend)
                {
                    <tr>
                        <td><strong>@m.MonthName</strong></td>
                        <td>@m.Year</td>
                        <td class="text-success fw-semibold">৳@m.Revenue.ToString("N0")</td>
                        <td class="text-danger">৳@m.Expenses.ToString("N0")</td>
                        <td class="@(m.NetProfit >= 0 ? "text-success fw-bold" : "text-danger fw-bold")">
                            ৳@m.NetProfit.ToString("N0")
                        </td>
                        <td>@(m.Revenue > 0 ? (m.NetProfit / m.Revenue * 100).ToString("F1") + "%" : "—")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="card">
    <div class="card-header"><h6><i class="bi bi-list-ul me-2"></i>All Transactions</h6></div>
    <div class="table-responsive">
        <table class="table mb-0" style="font-size:12px">
            <thead><tr><th>Date</th><th>Type</th><th>Category</th><th>Description</th><th>Farm</th><th>Amount</th><th>Status</th></tr></thead>
            <tbody>
                @foreach (var t in transactions)
                {
                    <tr>
                        <td>@t.TxnDate.ToString("dd MMM yyyy")</td>
                        <td><span class="badge @(t.TxnType=="Sale"?"badge-healthy":t.TxnType=="Purchase"?"badge-info-soft":"badge-danger-soft")">@t.TxnType</span></td>
                        <td><small class="text-muted">@t.Category</small></td>
                        <td>@t.Description</td>
                        <td><small class="text-muted">@(t.FarmName ?? "—")</small></td>
                        <td class="fw-semibold @(t.Amount >= 0 ? "text-success" : "text-danger")">
                            @(t.Amount >= 0 ? "+" : "")৳@Math.Abs(t.Amount).ToString("N0")
                        </td>
                        <td><span class="badge @(t.PaymentStatus=="Paid"?"badge-healthy":"badge-warning-soft")">@t.PaymentStatus</span></td>
                    </tr>
                }
            </tbody>
            <tfoot class="table-light fw-bold">
                <tr>
                    <td colspan="5">Total</td>
                    <td class="@(transactions.Sum(t => t.Amount) >= 0 ? "text-success" : "text-danger")">
                        ৳@transactions.Sum(t => t.Amount).ToString("N0")
                    </td>
                    <td></td>
                </tr>
            </tfoot>
        </table>
    </div>
</div>
