@{
    var batches = ((ViewBag.Batches as IEnumerable<Batch>)?.ToList() ?? new List<Batch>());
    var logs = ((ViewBag.MortalityLogs as IEnumerable<MortalityLog>)?.ToList() ?? new List<MortalityLog>());
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <a asp-action="Index" class="btn btn-sm btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i>All Reports</a>
    <button onclick="window.print()" class="btn btn-sm btn-outline-primary"><i class="bi bi-printer me-1"></i>Print</button>
</div>

<div class="row g-3 mb-4">
    <div class="col-6 col-md-3"><div class="kpi-card">
        <div class="kpi-label">Total Birds</div>
        <div class="kpi-value">@(((int)ViewBag.TotalBirds).ToString("N0"))</div>
    </div></div>
    <div class="col-6 col-md-3"><div class="kpi-card">
        <div class="kpi-label">Total Mortality</div>
        <div class="kpi-value text-danger">@(((int)ViewBag.TotalMortality).ToString("N0"))</div>
    </div></div>
    <div class="col-6 col-md-3"><div class="kpi-card">
        <div class="kpi-label">Avg FCR</div>
        <div class="kpi-value">@(((decimal)ViewBag.AvgFCR).ToString("F2"))</div>
    </div></div>
    <div class="col-6 col-md-3"><div class="kpi-card">
        <div class="kpi-label">Avg Weight (kg)</div>
        <div class="kpi-value">@(((decimal)ViewBag.AvgWeight).ToString("F3"))</div>
    </div></div>
</div>

<div class="card mb-4">
    <div class="card-header"><h6><i class="bi bi-feather2 text-success me-2"></i>All Batches — Production Summary</h6></div>
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead>
                <tr><th>Batch</th><th>Breed</th><th>Farm</th><th>Initial</th><th>Current</th><th>Mortality</th><th>Mort. Rate</th><th>Age (d)</th><th>Avg Weight</th><th>Total Feed (kg)</th><th>FCR</th><th>Status</th></tr>
            </thead>
            <tbody>
                @foreach (var b in batches)
                {
                    <tr>
                        <td><strong>@b.BatchCode</strong></td>
                        <td>@b.Breed</td>
                        <td><small class="text-muted">@b.FarmName</small></td>
                        <td>@b.InitialCount.ToString("N0")</td>
                        <td>@b.CurrentCount.ToString("N0")</td>
                        <td class="text-danger">@b.MortalityCount</td>
                        <td class="@(b.MortalityRate > 2 ? "text-danger fw-bold" : "")">@b.MortalityRate%</td>
                        <td>@b.AgeInDays</td>
                        <td>@b.AverageWeightKg kg</td>
                        <td>@b.TotalFeedKg.ToString("N0")</td>
                        <td class="@(b.FCR > 1.9m ? "text-warning fw-semibold" : "")">@b.FCR</td>
                        <td>
                            <span class="badge @(b.HealthStatus == "Healthy" ? "badge-healthy" : b.HealthStatus == "Ready for Sale" ? "badge-ready" : "badge-warning-soft")">
                                @b.HealthStatus
                            </span>
                        </td>
                    </tr>
                }
            </tbody>
            <tfoot class="table-light fw-semibold">
                <tr>
                    <td colspan="3">Total</td>
                    <td>@batches.Sum(b => b.InitialCount).ToString("N0")</td>
                    <td>@batches.Sum(b => b.CurrentCount).ToString("N0")</td>
                    <td class="text-danger">@batches.Sum(b => b.MortalityCount)</td>
                    <td colspan="3"></td>
                    <td>@batches.Sum(b => b.TotalFeedKg).ToString("N0")</td>
                    <td colspan="2"></td>
                </tr>
            </tfoot>
        </table>
    </div>
</div>

<div class="card">
    <div class="card-header"><h6><i class="bi bi-clipboard2-pulse text-danger me-2"></i>Mortality Log</h6></div>
    <div class="table-responsive">
        <table class="table mb-0">
            <thead><tr><th>Date</th><th>Batch</th><th>Farm</th><th>Count</th><th>Cause</th></tr></thead>
            <tbody>
                @foreach (var log in logs)
                {
                    <tr>
                        <td>@log.LogDate.ToString("dd MMM yyyy")</td>
                        <td><strong>@log.BatchCode</strong></td>
                        <td><small class="text-muted">@log.FarmName</small></td>
                        <td class="text-danger fw-semibold">@log.Count</td>
                        <td>@log.Cause</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
