@model UserFormVm
@{
    var officers = ((ViewBag.FieldOfficers as IEnumerable<FieldOfficer>)?.ToList() ?? new List<FieldOfficer>());
    var isNew = Model.Id == 0;
    var self = Model.Id == User.UserId();
}
<div class="row justify-content-center g-4">
<div class="col-xl-8">
<form asp-action="@(isNew ? "Create" : "Edit")" method="post" class="form-card" autocomplete="off">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />
    <div asp-validation-summary="ModelOnly" class="text-danger small mb-2"></div>
    <h6 class="fw-semibold mb-4"><i class="bi bi-person-lock text-primary me-2"></i>@(isNew ? "New user account" : "Edit " + Model.Username)</h6>

    <div class="row g-3 mb-4">
        <div class="col-md-6">
            <label asp-for="FullName" class="form-label">Full name *</label>
            <input asp-for="FullName" class="form-control" maxlength="150" />
            <span asp-validation-for="FullName" class="text-danger small"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="Username" class="form-label">Username *</label>
            <input asp-for="Username" class="form-control mono" maxlength="60" autocomplete="off" />
            <span asp-validation-for="Username" class="text-danger small"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="Email" class="form-label">Email</label>
            <input asp-for="Email" type="email" class="form-control" maxlength="150" />
            <span asp-validation-for="Email" class="text-danger small"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="Phone" class="form-label">Phone</label>
            <input asp-for="Phone" class="form-control" maxlength="20" />
        </div>
    </div>

    <div class="section-title mb-2 text-xs text-uppercase text-muted">Role &amp; access</div>
    <div class="row g-2 mb-3">
        @foreach (var r in Roles.All)
        {
            <div class="col-md-6">
                <label class="d-flex gap-2 p-2 border rounded h-100" style="cursor:pointer">
                    <input type="radio" name="Role" value="@r" class="form-check-input mt-1 role-radio" checked="@(Model.Role == r)" disabled="@(self && r != Roles.Admin)" />
                    <span><span class="fw-600">@r</span><span class="d-block text-xs text-muted">@Roles.Describe(r)</span></span>
                </label>
            </div>
        }
        @if (self) { <input type="hidden" name="Role" value="@Roles.Admin" /> }
        <span asp-validation-for="Role" class="text-danger small"></span>
    </div>
    <div class="row g-3 mb-4" id="foBox">
        <div class="col-md-8">
            <label asp-for="FieldOfficerId" class="form-label">Link to field officer profile</label>
            <select asp-for="FieldOfficerId" class="form-select">
                <option value="">— not linked —</option>
                @foreach (var fo in officers) { <option value="@fo.Id">@fo.FullName@(fo.Zone != null ? $" · {fo.Zone}" : "")</option> }
            </select>
            <div class="form-text">Linking scopes the user's visits and daily records to that officer's assigned farms.</div>
        </div>
    </div>

    <div class="section-title mb-2 text-xs text-uppercase text-muted">@(isNew ? "Password" : "Reset password (optional)")</div>
    <div class="row g-3">
        <div class="col-md-6">
            <label asp-for="Password" class="form-label">@(isNew ? "Password *" : "New password")</label>
            <input asp-for="Password" class="form-control" autocomplete="new-password" placeholder="@(isNew ? "At least 6 characters" : "Leave blank to keep current")" />
            <span asp-validation-for="Password" class="text-danger small"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="ConfirmPassword" class="form-label">Confirm password</label>
            <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
            <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
        </div>
        @if (!isNew)
        {
            <div class="col-12">
                <div class="form-check form-switch">
                    @if (self)
                    {
                        <input class="form-check-input" type="checkbox" role="switch" id="IsActive" checked disabled />
                        <input type="hidden" name="IsActive" value="true" />
                        <label class="form-check-label" for="IsActive">Account active (you cannot deactivate yourself)</label>
                    }
                    else
                    {
                        <input asp-for="IsActive" class="form-check-input" type="checkbox" role="switch" />
                        <label asp-for="IsActive" class="form-check-label">Account active</label>
                    }
                </div>
                <span asp-validation-for="IsActive" class="text-danger small"></span>
            </div>
        }
        else
        {
            <input type="hidden" name="IsActive" value="true" />
        }
    </div>

    <div class="d-flex gap-2 mt-4">
        <button class="btn btn-primary"><i class="bi bi-check-lg me-1"></i>@(isNew ? "Create user" : "Save changes")</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
    </div>
</form>
</div>
@if (!isNew)
{
    <div class="col-xl-4">
        <div class="card">
            <div class="card-header"><h6><i class="bi bi-info-circle text-primary me-2"></i>Account</h6></div>
            <div class="card-body">
                <dl class="kv" style="grid-template-columns:100px 1fr">
                    <dt>Created</dt><dd>@Fmt.Date(Model.CreatedAt)</dd>
                    <dt>Last login</dt><dd>@Fmt.Ago(Model.LastLoginAt)<div class="text-xs text-muted">@Fmt.DateTime(Model.LastLoginAt)</div></dd>
                </dl>
                <a asp-controller="AuditLog" asp-action="Index" asp-route-user="@Model.Username" class="btn btn-sm btn-outline-secondary w-100 mt-3"><i class="bi bi-clock-history me-1"></i>View this user's activity</a>
            </div>
        </div>
    </div>
}
</div>

@section Scripts {
<script>
(function () {
    function sync() {
        var r = document.querySelector('.role-radio:checked');
        document.getElementById('foBox').style.display = r && r.value === 'FieldOfficer' ? '' : 'none';
    }
    document.querySelectorAll('.role-radio').forEach(function (x) { x.addEventListener('change', sync); });
    sync();
})();
</script>
}
