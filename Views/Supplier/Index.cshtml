@model List<SupplierCardVm>
@{
    var cats = ((ViewBag.Categories as IEnumerable<string>)?.ToList() ?? new List<string>());
    string? selCat = ViewBag.Category;
    bool inactive = ViewBag.Inactive;
    string? sort = ViewBag.Sort;
    decimal? onTime = ViewBag.OnTimePct;
    decimal avgRating = ViewBag.AvgRating;
    var canEdit = User.IsAny(Roles.Finance);
    var spendByCat = ((ViewBag.SpendByCategory as IEnumerable<(string Category, decimal Spend)>)?.ToList() ?? new List<(string Category, decimal Spend)>());
}

<div class="stat-grid">
    <div class="stat-tile tone-green">
        <div class="st-label">Active suppliers</div>
        <div class="st-value">@ViewBag.ActiveCount</div>
        <div class="st-sub">@ViewBag.InactiveCount inactive</div>
        <div class="st-icon"><i class="bi bi-buildings"></i></div>
    </div>
    <div class="stat-tile tone-blue">
        <div class="st-label">Lifetime spend</div>
        <div class="st-value">@Fmt.MoneyShort((decimal)ViewBag.TotalSpend)</div>
        <div class="st-sub">Non-cancelled purchase orders</div>
        <div class="st-icon"><i class="bi bi-cash-stack"></i></div>
    </div>
    <div class="stat-tile tone-amber">
        <div class="st-label">Average rating</div>
        <div class="st-value">@avgRating.ToString("0.0") <small class="text-muted" style="font-size:14px">/ 5</small></div>
        <div class="st-sub">Buyer-assigned vendor score</div>
        <div class="st-icon"><i class="bi bi-star-half"></i></div>
    </div>
    <div class="stat-tile tone-violet">
        <div class="st-label">On-time delivery</div>
        <div class="st-value">@(onTime.HasValue ? Fmt.Pct(onTime.Value) : "—")</div>
        <div class="st-sub">Received on or before expected date</div>
        <div class="st-icon"><i class="bi bi-truck"></i></div>
    </div>
</div>

<form method="get" class="filter-bar">
    <div>
        <label class="form-label">Category</label>
        <select name="category" class="form-select" onchange="this.form.submit()">
            <option value="">All categories</option>
            @foreach (var c in cats)
            {
                <option value="@c" selected="@(c == selCat)">@c</option>
            }
        </select>
    </div>
    <div>
        <label class="form-label">Sort by</label>
        <select name="sort" class="form-select" onchange="this.form.submit()">
            <option value="" selected="@(string.IsNullOrEmpty(sort))">Name</option>
            <option value="spend" selected="@(sort == "spend")">Total spend</option>
            <option value="rating" selected="@(sort == "rating")">Rating</option>
            <option value="ontime" selected="@(sort == "ontime")">On-time %</option>
        </select>
    </div>
    <div class="form-check mb-2">
        <input class="form-check-input" type="checkbox" name="inactive" value="true" id="chkInactive" checked="@inactive" onchange="this.form.submit()" />
        <label class="form-check-label small" for="chkInactive">Show inactive</label>
    </div>
    <div class="ms-auto d-flex gap-2">
        <input type="search" class="form-control" placeholder="Quick search…" id="supSearch" style="width:200px" />
        <a asp-controller="Purchase" asp-action="Index" class="btn btn-outline-secondary btn-sm"><i class="bi bi-truck me-1"></i>Purchase orders</a>
        @if (canEdit)
        {
            <a asp-action="Create" class="btn btn-primary btn-sm"><i class="bi bi-plus-lg me-1"></i>Add supplier</a>
        }
    </div>
</form>

@if (Model.Count == 0)
{
    <div class="card"><div class="empty-state"><i class="bi bi-buildings"></i>No suppliers match this filter.
        @if (canEdit) { <div class="mt-2"><a asp-action="Create" class="btn btn-sm btn-primary">Add the first supplier</a></div> }
    </div></div>
}
else
{
    <div class="row g-3 mb-4" id="supGrid">
        @foreach (var c in Model)
        {
            var s = c.Supplier;
            var p = c.Perf;
            var pct = p?.OnTimePct;
            <div class="col-md-6 col-xl-4 sup-card">
                <div class="card h-100 @(s.IsActive ? "" : "opacity-75")">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start gap-2">
                            <div class="d-flex gap-2 align-items-center">
                                <div class="avatar" style="background:#e1f5ee;color:#0a7d5e">@(s.Name.Length > 0 ? s.Name[..1] : "?")</div>
                                <div>
                                    <a asp-action="Detail" asp-route-id="@s.Id" class="fw-600 text-decoration-none text-reset">@s.Name</a>
                                    <div class="text-xs text-muted">@(s.ContactPerson ?? "No contact")@(string.IsNullOrEmpty(s.Phone) ? "" : " · " + s.Phone)</div>
                                </div>
                            </div>
                            <div class="text-end">
                                <span class="chip">@s.Category</span>
                                @if (!s.IsActive) { <div><span class="badge badge-danger-soft mt-1">Inactive</span></div> }
                            </div>
                        </div>
                        <div class="my-2" title="@s.Rating.ToString("0.0") / 5">
                            @for (var i = 1; i <= 5; i++)
                            {
                                var icon = s.Rating >= i ? "bi-star-fill" : s.Rating >= i - 0.5m ? "bi-star-half" : "bi-star";
                                <i class="bi @icon text-warning"></i>
                            }
                            <span class="text-xs text-muted ms-1">@s.Rating.ToString("0.0")</span>
                            @if (!string.IsNullOrEmpty(s.PaymentTerms)) { <span class="chip ms-2"><i class="bi bi-calendar2-check"></i>@s.PaymentTerms</span> }
                        </div>
                        <div class="row g-2 text-center mt-1">
                            <div class="col-4">
                                <div class="text-xs text-muted">Total spend</div>
                                <div class="fw-600">@Fmt.MoneyShort(p?.TotalSpend ?? 0)</div>
                            </div>
                            <div class="col-4">
                                <div class="text-xs text-muted">POs</div>
                                <div class="fw-600">@(p?.TotalOrders ?? 0)</div>
                            </div>
                            <div class="col-4">
                                <div class="text-xs text-muted">Items</div>
                                <div class="fw-600">@c.ItemCount</div>
                            </div>
                        </div>
                        <div class="mt-3">
                            <div class="d-flex justify-content-between text-xs mb-1">
                                <span class="text-muted">On-time delivery</span>
                                <span class="fw-600">@(pct.HasValue ? Fmt.Pct(pct.Value, 0) : "no receipts yet")</span>
                            </div>
                            <div class="prog-bar-wrap">
                                <div class="prog-bar-fill @(pct < 60 ? "danger" : pct < 85 ? "warning" : "")" style="width:@((int)(pct ?? 0))%"></div>
                            </div>
                        </div>
                        <div class="d-flex gap-1 mt-3">
                            <a asp-action="Detail" asp-route-id="@s.Id" class="btn btn-xs btn-outline-primary"><i class="bi bi-eye me-1"></i>Details</a>
                            @if (canEdit && s.IsActive)
                            {
                                <a asp-controller="Purchase" asp-action="Create" asp-route-supplierId="@s.Id" class="btn btn-xs btn-outline-success"><i class="bi bi-cart-plus me-1"></i>New PO</a>
                                <a asp-action="Edit" asp-route-id="@s.Id" class="btn btn-xs btn-outline-secondary ms-auto"><i class="bi bi-pencil"></i></a>
                                <form asp-action="Delete" method="post" data-confirm="Deactivate @s.Name? Purchase history is kept.">
                                    <input type="hidden" name="id" value="@s.Id" />
                                    <button class="btn btn-xs btn-outline-danger" title="Deactivate"><i class="bi bi-slash-circle"></i></button>
                                </form>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}

@if (spendByCat.Count > 0)
{
    <div class="card">
        <div class="card-header"><h6><i class="bi bi-pie-chart text-primary me-2"></i>Spend by supplier category</h6></div>
        <div class="card-body"><div style="height:240px"><canvas id="spendChart"></canvas></div></div>
    </div>
}

@section Scripts {
<script>
document.getElementById('supSearch')?.addEventListener('input', function () {
    const q = this.value.toLowerCase();
    document.querySelectorAll('#supGrid .sup-card').forEach(c => c.style.display = c.textContent.toLowerCase().includes(q) ? '' : 'none');
});
@if (spendByCat.Count > 0)
{
    <text>
    new Chart(document.getElementById('spendChart'), {
        type: 'bar',
        data: {
            labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(spendByCat.Select(x => x.Category))),
            datasets: [{ label: 'Spend', data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(spendByCat.Select(x => x.Spend))), backgroundColor: ppColors.series, borderRadius: 6 }]
        },
        options: { indexAxis: 'y', plugins: { legend: { display: false }, tooltip: { callbacks: { label: c => ppMoney(c.raw) } } },
                   scales: { x: { ticks: { callback: v => ppMoney(v) } } } }
    });
    </text>
}
</script>
}
