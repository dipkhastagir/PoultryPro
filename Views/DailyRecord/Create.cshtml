@model DailyRecordCreateVm
@{
    ViewData["Title"]    = "Add Daily Record";
    ViewData["Subtitle"] = "Enter today's farm observations";
    var visit   = ViewBag.Visit   as FarmVisit;
    var batches = ((ViewBag.Batches as IEnumerable<Batch>)?.ToList() ?? new List<Batch>());
}

<!-- Visit Context Banner -->
@if (visit != null)
{
    <div class="alert alert-info d-flex align-items-center gap-3 mb-4 py-2" style="border-radius:10px">
        <i class="bi bi-geo-alt-fill fs-5"></i>
        <div>
            <strong>@visit.FarmName</strong>
            @if (!string.IsNullOrEmpty(visit.BatchCode))
            { <span class="badge badge-info-soft ms-2">@visit.BatchCode</span> }
            <span class="text-muted ms-2" style="font-size:12px">
                · @visit.FieldOfficerName · @visit.VisitDate.ToString("dd MMM yyyy")
            </span>
        </div>
    </div>
}

<div class="row justify-content-center">
<div class="col-lg-9">
<div class="form-card">
    <h6 class="fw-semibold mb-4"><i class="bi bi-clipboard2-plus text-info me-2"></i>Daily Farm Record</h6>

    <form asp-action="Create" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="VisitId" />
        <input type="hidden" asp-for="FarmId" />

        <!-- Batch & Date -->
        <div class="row g-3 mb-4">
            <div class="col-md-6">
                <label class="form-label">Batch *</label>
                <select asp-for="BatchId" class="form-select" required>
                    <option value="">-- Select Batch --</option>
                    @foreach (var b in batches)
                    {
                        <option value="@b.Id" selected="@(Model.BatchId == b.Id)">
                            @b.BatchCode — @b.Breed (Day @b.AgeInDays)
                        </option>
                    }
                </select>
            </div>
            <div class="col-md-6">
                <label class="form-label">Record Date *</label>
                <input asp-for="RecordDate" type="date" class="form-control" required />
            </div>
        </div>

        <hr class="my-3" />

        <!-- 🐓 BIRD METRICS -->
        <div class="mb-2" style="font-size:11.5px;font-weight:600;text-transform:uppercase;letter-spacing:.06em;color:var(--text-muted)">
            🐓 Bird Count
        </div>
        <div class="row g-3 mb-4">
            <div class="col-md-4">
                <label class="form-label">Bird Count *</label>
                <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-stack"></i></span>
                    <input asp-for="BirdCount" type="number" class="form-control" min="0" required />
                </div>
            </div>
            <div class="col-md-4">
                <label class="form-label">Mortality Count</label>
                <div class="input-group">
                    <span class="input-group-text text-danger"><i class="bi bi-heartbreak"></i></span>
                    <input asp-for="MortalityCount" type="number" class="form-control" min="0" />
                </div>
            </div>
            <div class="col-md-4">
                <label class="form-label">Culling Count</label>
                <div class="input-group">
                    <span class="input-group-text text-warning"><i class="bi bi-scissors"></i></span>
                    <input asp-for="CullingCount" type="number" class="form-control" min="0" />
                </div>
            </div>
        </div>

        <hr class="my-3" />

        <!-- 🌾 FEED & WATER -->
        <div class="mb-2" style="font-size:11.5px;font-weight:600;text-transform:uppercase;letter-spacing:.06em;color:var(--text-muted)">
            🌾 Feed & Water
        </div>
        <div class="row g-3 mb-4">
            <div class="col-md-6">
                <label class="form-label">Feed Consumption (kg) *</label>
                <div class="input-group">
                    <span class="input-group-text">kg</span>
                    <input asp-for="FeedConsumptionKg" type="number" step="0.01" class="form-control" min="0" required />
                </div>
            </div>
            <div class="col-md-6">
                <label class="form-label">Water Consumption (L)</label>
                <div class="input-group">
                    <span class="input-group-text">L</span>
                    <input asp-for="WaterConsumptionLtr" type="number" step="0.01" class="form-control" min="0" />
                </div>
            </div>
        </div>

        <hr class="my-3" />

        <!-- 🌡️ ENVIRONMENT -->
        <div class="mb-2" style="font-size:11.5px;font-weight:600;text-transform:uppercase;letter-spacing:.06em;color:var(--text-muted)">
            🌡️ Environment
        </div>
        <div class="row g-3 mb-4">
            <div class="col-md-4">
                <label class="form-label">Temperature (°C)</label>
                <div class="input-group">
                    <span class="input-group-text">°C</span>
                    <input asp-for="TemperatureC" type="number" step="0.1" class="form-control"
                           min="0" max="60" placeholder="e.g. 32.5" />
                </div>
            </div>
            <div class="col-md-4">
                <label class="form-label">Humidity (%)</label>
                <div class="input-group">
                    <span class="input-group-text">%</span>
                    <input asp-for="HumidityPercent" type="number" step="0.1" class="form-control"
                           min="0" max="100" placeholder="e.g. 65" />
                </div>
            </div>
            <div class="col-md-4">
                <label class="form-label">Light Hours</label>
                <div class="input-group">
                    <span class="input-group-text">h</span>
                    <input asp-for="LightHours" type="number" step="0.5" class="form-control"
                           min="0" max="24" placeholder="e.g. 16.0" />
                </div>
            </div>
        </div>

        <hr class="my-3" />

        <!-- ⚖️ GROWTH -->
        <div class="mb-2" style="font-size:11.5px;font-weight:600;text-transform:uppercase;letter-spacing:.06em;color:var(--text-muted)">
            ⚖️ Growth
        </div>
        <div class="row g-3 mb-4">
            <div class="col-md-6">
                <label class="form-label">Average Weight (grams)</label>
                <div class="input-group">
                    <span class="input-group-text">g</span>
                    <input asp-for="AverageWeightGm" type="number" step="0.01" class="form-control"
                           min="0" placeholder="e.g. 840" />
                </div>
                <div class="form-text">Sample a few birds and enter average weight in grams.</div>
            </div>
        </div>

        <hr class="my-3" />

        <!-- 💊 MEDICINE & VACCINE -->
        <div class="mb-2" style="font-size:11.5px;font-weight:600;text-transform:uppercase;letter-spacing:.06em;color:var(--text-muted)">
            💊 Medicine & Vaccine
        </div>
        <div class="row g-3 mb-4">
            <div class="col-md-6">
                <label class="form-label">Medicine Used</label>
                <input asp-for="MedicineUsed" class="form-control"
                       placeholder="e.g. Enrofloxacin 10%, Tylosin" />
            </div>
            <div class="col-md-6">
                <label class="form-label">Medicine Dosage</label>
                <input asp-for="MedicineDosage" class="form-control"
                       placeholder="e.g. 1ml/L water, 2x daily" />
            </div>
            <div class="col-12">
                <label class="form-label">Vaccine Used</label>
                <input asp-for="VaccineUsed" class="form-control"
                       placeholder="e.g. Newcastle (ND), Gumboro (IBD)" />
            </div>
        </div>

        <hr class="my-3" />

        <!-- 📝 REMARKS -->
        <div class="mb-2" style="font-size:11.5px;font-weight:600;text-transform:uppercase;letter-spacing:.06em;color:var(--text-muted)">
            📝 Remarks
        </div>
        <div class="mb-4">
            <textarea asp-for="Remarks" class="form-control" rows="3"
                      placeholder="Observations, issues, recommendations..."></textarea>
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary px-4">
                <i class="bi bi-check-lg me-1"></i>Save Record
            </button>
            @if (visit != null)
            {
                <a asp-controller="Visit" asp-action="Detail" asp-route-id="@Model.VisitId"
                   class="btn btn-outline-secondary">Cancel</a>
            }
        </div>
    </form>
</div>
</div>
</div>
