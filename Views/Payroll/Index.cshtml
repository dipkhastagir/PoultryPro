@model PayrollRegisterVm
@{
    var start = new DateTime(Model.Year, Model.Month, 1);
    var prev = start.AddMonths(-1);
    var next = start.AddMonths(1);
    var isFuture = start > DateTime.Today;
    var paidPct = Model.TotalNet == 0 ? 0 : Model.PaidNet / Model.TotalNet * 100;
    var byFarm = Model.Rows.GroupBy(r => r.FarmName ?? "Head office").Select(g => new { Farm = g.Key, Net = g.Sum(x => x.NetPay) }).OrderByDescending(x => x.Net).ToList();
}

<div class="page-head">
    <div>
        <h4>Payroll register — @Model.MonthLabel</h4>
        <p>@Model.Rows.Count entries · @Model.ActiveEmployees active employees eligible</p>
    </div>
    <div class="d-flex gap-2 flex-wrap align-items-center">
        <a asp-action="Index" asp-route-year="@prev.Year" asp-route-month="@prev.Month" class="btn btn-sm btn-outline-secondary"><i class="bi bi-chevron-left"></i> @prev.ToString("MMM")</a>
        <form method="get" class="d-flex">
            <input type="month" class="form-control form-control-sm" value="@start.ToString("yyyy-MM")" onchange="var p=this.value.split('-');this.form.year.value=p[0];this.form.month.value=+p[1];this.form.submit()" />
            <input type="hidden" name="year" value="@Model.Year" /><input type="hidden" name="month" value="@Model.Month" />
        </form>
        <a asp-action="Index" asp-route-year="@next.Year" asp-route-month="@next.Month" class="btn btn-sm btn-outline-secondary">@next.ToString("MMM") <i class="bi bi-chevron-right"></i></a>
        @if (Model.MissingRows > 0 && !isFuture)
        {
            <form asp-action="Generate" method="post" class="d-inline" data-confirm="Generate payroll for @Model.MissingRows employee(s) from salary and attendance?">
                @Html.AntiForgeryToken()
                <input type="hidden" name="year" value="@Model.Year" /><input type="hidden" name="month" value="@Model.Month" />
                <button class="btn btn-sm btn-primary"><i class="bi bi-lightning-charge me-1"></i>Generate (@Model.MissingRows)</button>
            </form>
        }
        @if (Model.PendingCount > 0)
        {
            <form asp-action="MarkPaid" method="post" class="d-inline" data-confirm="Mark all @Model.PendingCount pending salaries as paid (@Fmt.Money(Model.PendingNet))? A Salary transaction will be posted to finance for each.">
                @Html.AntiForgeryToken()
                <input type="hidden" name="year" value="@Model.Year" /><input type="hidden" name="month" value="@Model.Month" />
                <button class="btn btn-sm btn-success"><i class="bi bi-check2-all me-1"></i>Pay all pending</button>
            </form>
        }
    </div>
</div>

<div class="stat-grid">
    <div class="stat-tile tone-violet">
        <div class="st-label">Total net payroll</div>
        <div class="st-value">@Fmt.Money(Model.TotalNet)</div>
        <div class="st-sub">Gross @Fmt.MoneyShort(Model.TotalBasic + Model.TotalAllowances + Model.TotalOvertime) − deductions @Fmt.MoneyShort(Model.TotalDeductions)</div>
        <div class="st-icon"><i class="bi bi-cash-stack"></i></div>
    </div>
    <div class="stat-tile tone-green">
        <div class="st-label">Paid</div>
        <div class="st-value">@Fmt.Money(Model.PaidNet)</div>
        <div class="st-sub">@(Model.Rows.Count - Model.PendingCount) employees · @Fmt.Pct(paidPct, 0)</div>
        <div class="st-icon"><i class="bi bi-check-circle"></i></div>
    </div>
    <div class="stat-tile tone-amber">
        <div class="st-label">Pending</div>
        <div class="st-value">@Fmt.Money(Model.PendingNet)</div>
        <div class="st-sub">@Model.PendingCount employees awaiting payment</div>
        <div class="st-icon"><i class="bi bi-hourglass-split"></i></div>
    </div>
    <div class="stat-tile tone-red">
        <div class="st-label">Attendance deductions</div>
        <div class="st-value">@Fmt.Money(Model.TotalDeductions)</div>
        <div class="st-sub">@Model.Rows.Sum(r => r.DaysAbsent) absent days in total</div>
        <div class="st-icon"><i class="bi bi-dash-circle"></i></div>
    </div>
</div>

@if (Model.MissingRows > 0 && Model.Rows.Any() && !isFuture)
{
    <div class="warn-callout mb-3"><i class="bi bi-exclamation-triangle me-1"></i>@Model.MissingRows active employee(s) have no payroll entry for @Model.MonthLabel yet. Click <strong>Generate</strong> to add them.</div>
}

<div class="card mb-4">
    <div class="card-header">
        <h6><i class="bi bi-table text-primary me-2"></i>Register</h6>
        @if (Model.Rows.Any())
        {
            <input class="form-control form-control-sm" style="max-width:220px" placeholder="Filter…" data-table-filter="#payTbl" />
        }
    </div>
    @if (!Model.Rows.Any())
    {
        <div class="empty-state">
            <i class="bi bi-wallet2"></i>
            No payroll for @Model.MonthLabel yet.
            @if (!isFuture && Model.ActiveEmployees > 0)
            {
                <div class="mt-3">
                    <form asp-action="Generate" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="year" value="@Model.Year" /><input type="hidden" name="month" value="@Model.Month" />
                        <button class="btn btn-primary btn-sm"><i class="bi bi-lightning-charge me-1"></i>Generate payroll for @Model.ActiveEmployees employees</button>
                    </form>
                </div>
            }
            else if (isFuture)
            {
                <div class="small mt-2">Payroll can be generated once the month has started.</div>
            }
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover mb-0 align-middle" id="payTbl">
                <thead>
                    <tr><th>Employee</th><th>Farm</th><th class="text-center">Days P / A</th><th class="text-end">Basic</th><th class="text-end">Allowances</th><th class="text-end">Overtime</th><th class="text-end">Deductions</th><th class="text-end">Net pay</th><th>Status</th><th></th></tr>
                </thead>
                <tbody>
                    @foreach (var r in Model.Rows)
                    {
                        <tr>
                            <td>
                                <a asp-controller="Employee" asp-action="Detail" asp-route-id="@r.EmployeeId" class="fw-600 text-decoration-none">@r.FullName</a>
                                <div class="text-xs text-muted"><span class="mono">@r.CodeOrId</span> · @r.Role</div>
                            </td>
                            <td class="small text-muted">@(r.FarmName ?? "Head office")</td>
                            <td class="text-center small">@r.DaysPresent / <span class="@(r.DaysAbsent > 0 ? "text-danger fw-600" : "")">@r.DaysAbsent</span></td>
                            <td class="text-end">@Fmt.Money(r.BasicSalary)</td>
                            <td class="text-end">@Fmt.Money(r.Allowances)</td>
                            <td class="text-end">@Fmt.Money(r.Overtime)</td>
                            <td class="text-end text-danger">@(r.Deductions > 0 ? "−" + Fmt.Money(r.Deductions) : Fmt.Money(0m))</td>
                            <td class="text-end fw-600">@Fmt.Money(r.NetPay)</td>
                            <td>
                                <span class="badge @Fmt.Badge(r.Status)">@r.Status</span>
                                @if (r.PaidDate.HasValue) { <div class="text-xs text-muted">@Fmt.Date(r.PaidDate)</div> }
                            </td>
                            <td class="text-end text-nowrap">
                                <a asp-action="Payslip" asp-route-id="@r.Id" class="btn btn-xs btn-outline-secondary" title="Payslip"><i class="bi bi-receipt"></i></a>
                                @if (r.Status != "Paid")
                                {
                                    <a asp-action="Edit" asp-route-id="@r.Id" class="btn btn-xs btn-outline-secondary" title="Adjust"><i class="bi bi-pencil"></i></a>
                                    <form asp-action="MarkPaid" method="post" class="d-inline" data-confirm="Pay @r.FullName @Fmt.Money(r.NetPay)?">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@r.Id" />
                                        <button class="btn btn-xs btn-outline-success" title="Mark paid"><i class="bi bi-check-lg"></i></button>
                                    </form>
                                    <form asp-action="Delete" method="post" class="d-inline" data-confirm="Remove this payroll entry?">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@r.Id" />
                                        <button class="btn btn-xs btn-outline-danger" title="Remove"><i class="bi bi-trash"></i></button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr>
                        <td colspan="2">Totals (@Model.Rows.Count)</td>
                        <td class="text-center">@Model.Rows.Sum(r => r.DaysPresent) / @Model.Rows.Sum(r => r.DaysAbsent)</td>
                        <td class="text-end">@Fmt.Money(Model.TotalBasic)</td>
                        <td class="text-end">@Fmt.Money(Model.TotalAllowances)</td>
                        <td class="text-end">@Fmt.Money(Model.TotalOvertime)</td>
                        <td class="text-end text-danger">@Fmt.Money(Model.TotalDeductions)</td>
                        <td class="text-end">@Fmt.Money(Model.TotalNet)</td>
                        <td colspan="2"></td>
                    </tr>
                </tfoot>
            </table>
        </div>
    }
</div>

<div class="row g-4">
    <div class="col-lg-7">
        <div class="card h-100">
            <div class="card-header"><h6><i class="bi bi-bar-chart text-success me-2"></i>Net payroll — last 6 months</h6></div>
            <div class="card-body"><div style="height:240px"><canvas id="trendChart"></canvas></div></div>
        </div>
    </div>
    <div class="col-lg-5">
        <div class="card h-100">
            <div class="card-header"><h6><i class="bi bi-calculator text-primary me-2"></i>How payroll is generated</h6></div>
            <div class="card-body small">
                <div class="formula mb-2">Basic = monthly salary<br />Allowances = 10% × basic<br />Daily rate = salary ÷ 26<br />Deductions = absent days × daily rate<br />Net = basic + allowances + overtime − deductions</div>
                <p class="mb-2">Days present count <em>Present</em> and <em>Late</em> as one day and <em>Half Day</em> as half, from the attendance sheet.</p>
                <p class="mb-0 text-muted">Paying an entry posts a <strong>Salary</strong> expense to Finance with reference <span class="mono">PAY-yyyyMM-EMPCODE</span>; a reference is never posted twice.</p>
                @if (byFarm.Any())
                {
                    <hr />
                    @foreach (var f in byFarm)
                    {
                        <div class="d-flex justify-content-between py-1"><span>@f.Farm</span><strong>@Fmt.Money(f.Net)</strong></div>
                    }
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    new Chart(document.getElementById('trendChart'), {
        type: 'bar',
        data: {
            labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Trend.Select(t => t.Label))),
            datasets: [{ label: 'Net payroll', data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Trend.Select(t => t.Net))),
                         backgroundColor: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Trend.Select((t, i) => i == Model.Trend.Count - 1 ? "#8b5cf6" : "#0d9e75"))), borderRadius: 6 }]
        },
        options: { plugins: { legend: { display: false }, tooltip: { callbacks: { label: c => ppMoney(c.raw) } } },
                   scales: { y: { ticks: { callback: v => ppMoney(v) } }, x: { grid: { display: false } } } }
    });
</script>
}
