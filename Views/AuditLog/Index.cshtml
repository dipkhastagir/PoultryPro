@model AuditLogVm
@{
    var filtered = !string.IsNullOrEmpty(Model.User) || !string.IsNullOrEmpty(Model.Entity) || Model.From.HasValue || Model.To.HasValue;
    var todayCount = Model.Rows.Count(r => r.CreatedAt.Date == DateTime.Today);
    var deletes = Model.Rows.Count(r => r.Action.Contains("Delete", StringComparison.OrdinalIgnoreCase) || r.Action.Contains("Remove", StringComparison.OrdinalIgnoreCase));
    string ActionClass(string a) =>
        a.Contains("Delete", StringComparison.OrdinalIgnoreCase) || a.Contains("Remove", StringComparison.OrdinalIgnoreCase) ? "badge-danger-soft"
        : a.Contains("Create", StringComparison.OrdinalIgnoreCase) || a.Contains("Add", StringComparison.OrdinalIgnoreCase) ? "badge-healthy"
        : a.Contains("Edit", StringComparison.OrdinalIgnoreCase) || a.Contains("Update", StringComparison.OrdinalIgnoreCase) || a.Contains("Save", StringComparison.OrdinalIgnoreCase) ? "badge-info-soft"
        : a.Contains("Login", StringComparison.OrdinalIgnoreCase) ? "badge-gray" : "badge-warning-soft";
}

<div class="page-head">
    <div>
        <h4>Audit trail</h4>
        <p>@(Model.Rows.Count >= 1000 ? "Latest 1,000" : Model.Rows.Count.ToString("N0")) entries@(filtered ? " matching the filters" : "") · IP addresses and form fields are captured (passwords never)</p>
    </div>
    <a asp-action="Export" asp-route-user="@Model.User" asp-route-entity="@Model.Entity" asp-route-from="@Model.From?.ToString("yyyy-MM-dd")" asp-route-to="@Model.To?.ToString("yyyy-MM-dd")" class="btn btn-sm btn-outline-primary">
        <i class="bi bi-filetype-csv me-1"></i>Export CSV
    </a>
</div>

<form method="get" class="filter-bar">
    <div>
        <label class="form-label">User</label>
        <select name="user" class="form-select">
            <option value="">All users</option>
            @foreach (var u in Model.Users) { <option value="@u" selected="@(string.Equals(Model.User, u, StringComparison.OrdinalIgnoreCase))">@u</option> }
        </select>
    </div>
    <div>
        <label class="form-label">Entity / module</label>
        <select name="entity" class="form-select">
            <option value="">All entities</option>
            @foreach (var e in Model.Entities) { <option value="@e" selected="@(Model.Entity == e)">@e</option> }
        </select>
    </div>
    <div>
        <label class="form-label">From</label>
        <input type="date" name="from" value="@Model.From?.ToString("yyyy-MM-dd")" class="form-control" />
    </div>
    <div>
        <label class="form-label">To</label>
        <input type="date" name="to" value="@Model.To?.ToString("yyyy-MM-dd")" class="form-control" />
    </div>
    <button class="btn btn-sm btn-primary"><i class="bi bi-funnel me-1"></i>Apply</button>
    @if (filtered) { <a asp-action="Index" class="btn btn-sm btn-outline-secondary">Reset</a> }
    <div class="ms-auto d-flex gap-1 flex-wrap">
        <a asp-action="Index" asp-route-from="@DateTime.Today.ToString("yyyy-MM-dd")" class="chip text-decoration-none">Today</a>
        <a asp-action="Index" asp-route-from="@DateTime.Today.AddDays(-6).ToString("yyyy-MM-dd")" class="chip text-decoration-none">7 days</a>
        <a asp-action="Index" asp-route-from="@DateTime.Today.AddDays(-29).ToString("yyyy-MM-dd")" class="chip text-decoration-none">30 days</a>
    </div>
</form>

<div class="row g-4 mb-4">
    <div class="col-lg-8">
        <div class="card h-100">
            <div class="card-header">
                <h6><i class="bi bi-activity text-primary me-2"></i>Activity per day</h6>
                <span class="text-muted text-xs">@todayCount today · @deletes deletions in view</span>
            </div>
            <div class="card-body"><div style="height:190px"><canvas id="actChart"></canvas></div></div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="card h-100">
            <div class="card-header"><h6><i class="bi bi-bar-chart-steps text-success me-2"></i>Most active</h6></div>
            <div class="card-body small">
                @if (!Model.Rows.Any())
                {
                    <div class="text-muted">No activity in this range.</div>
                }
                else
                {
                    <div class="text-xs text-uppercase text-muted fw-600 mb-1">Users</div>
                    @foreach (var (name, n) in Model.TopUsers)
                    {
                        <a asp-action="Index" asp-route-user="@name" asp-route-entity="@Model.Entity" class="d-flex justify-content-between text-decoration-none text-reset py-1"><span class="mono">@name</span><strong>@n</strong></a>
                    }
                    <div class="text-xs text-uppercase text-muted fw-600 mt-3 mb-1">Entities</div>
                    @foreach (var (name, n) in Model.TopEntities)
                    {
                        var max = Model.TopEntities.Max(x => x.Count);
                        <a asp-action="Index" asp-route-entity="@name" asp-route-user="@Model.User" class="d-block text-decoration-none text-reset py-1">
                            <div class="d-flex justify-content-between"><span>@name</span><strong>@n</strong></div>
                            <div class="prog-bar-wrap" style="height:5px"><div class="prog-bar-fill" style="width:@(n * 100 / Math.Max(1, max))%"></div></div>
                        </a>
                    }
                }
            </div>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-header">
        <h6><i class="bi bi-clock-history text-primary me-2"></i>Entries</h6>
        <input class="form-control form-control-sm" style="max-width:240px" placeholder="Quick filter…" data-table-filter="#auditTbl" />
    </div>
    @if (!Model.Rows.Any())
    {
        <div class="empty-state"><i class="bi bi-journal-x"></i>No audit entries match these filters.</div>
    }
    else
    {
        <div class="table-responsive" style="max-height:640px">
            <table class="table table-hover table-sm mb-0 align-middle" id="auditTbl">
                <thead style="position:sticky;top:0;z-index:1"><tr><th>When</th><th>User</th><th>Action</th><th>Entity</th><th>Id</th><th>Details</th><th>IP</th></tr></thead>
                <tbody>
                    @foreach (var r in Model.Rows)
                    {
                        <tr>
                            <td class="text-nowrap small" title="@Fmt.DateTime(r.CreatedAt)">@r.CreatedAt.ToString("dd MMM HH:mm:ss")<div class="text-xs text-muted">@Fmt.Ago(r.CreatedAt)</div></td>
                            <td class="mono">@(r.UserName ?? "—")</td>
                            <td><span class="badge @ActionClass(r.Action)">@r.Action</span></td>
                            <td>@r.Entity</td>
                            <td class="mono">@(r.EntityId ?? "")</td>
                            <td class="small text-muted" style="max-width:420px;word-break:break-word">@r.Details</td>
                            <td class="mono text-muted">@r.IpAddress</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@section Scripts {
<script>
    new Chart(document.getElementById('actChart'), {
        type: 'bar',
        data: {
            labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.PerDay.Select(p => p.Day.ToString("dd MMM")))),
            datasets: [{ label: 'Actions', data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.PerDay.Select(p => p.Count))), backgroundColor: ppColors.blue, borderRadius: 3 }]
        },
        options: { plugins: { legend: { display: false } }, scales: { x: { grid: { display: false }, ticks: { maxRotation: 0, autoSkip: true, maxTicksLimit: 12 } }, y: { beginAtZero: true, ticks: { precision: 0 } } } }
    });
</script>
}
