<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="form-card text-center py-5">
            <div class="score-ring mx-auto mb-3" style="background:#fee2e2;color:#b91c1c"><i class="bi bi-bug fs-3"></i></div>
            <h5 class="fw-bold">Something went wrong</h5>
            <p class="text-muted mb-1">The request could not be completed. The error has been logged.</p>
            @if (ViewBag.Message != null) { <div class="warn-callout text-start my-3 small">@ViewBag.Message</div> }
            <p class="text-xs text-muted">Request ID: <span class="mono">@ViewBag.RequestId</span></p>
            <a href="javascript:history.back()" class="btn btn-outline-secondary btn-sm">Go back</a>
            <a asp-controller="Dashboard" asp-action="Index" class="btn btn-primary btn-sm">Dashboard</a>
        </div>
    </div>
</div>
