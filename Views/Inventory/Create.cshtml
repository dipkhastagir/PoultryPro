@model InventoryItem
@{
    var isNew = Model.Id == 0;
    var suppliers = ViewBag.Suppliers as IEnumerable<Supplier> ?? new List<Supplier>();
    var cats = ViewBag.Categories as string[] ?? Array.Empty<string>();
    var units = new[] { "kg", "g", "ton", "L", "ml", "pcs", "dose", "vial", "bag", "box" };
}
<div class="row justify-content-center"><div class="col-lg-8">
<div class="form-card">
    <h6 class="fw-semibold mb-1"><i class="bi bi-box-seam text-primary me-2"></i>@(isNew ? "Add inventory item" : "Edit " + Model.Name)</h6>
    <p class="text-muted small mb-4">@(isNew ? "An opening balance is posted to the stock ledger for the initial quantity." : "Changing the quantity posts a stock-count correction to the ledger.")</p>
    <form asp-action="@(isNew ? "Create" : "Edit")" method="post" novalidate>
        <input type="hidden" asp-for="Id" />
        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>
        <div class="row g-3">
            <div class="col-md-8">
                <label class="form-label">Item name *</label>
                <input asp-for="Name" class="form-control" required maxlength="200" />
                <span asp-validation-for="Name" class="text-danger small"></span>
            </div>
            <div class="col-md-4">
                <label class="form-label">SKU</label>
                <input asp-for="SKU" class="form-control mono text-uppercase" maxlength="40" placeholder="e.g. FD-BST-01" />
                <span asp-validation-for="SKU" class="text-danger small"></span>
            </div>
            <div class="col-md-4">
                <label class="form-label">Category *</label>
                <select asp-for="Category" class="form-select">
                    @foreach (var c in cats.Union(new[] { Model.Category }).Where(c => !string.IsNullOrEmpty(c)).Distinct())
                    {
                        <option value="@c">@c</option>
                    }
                </select>
            </div>
            <div class="col-md-4">
                <label class="form-label">@(isNew ? "Opening quantity" : "Quantity on hand") *</label>
                <input asp-for="Quantity" type="number" step="0.01" class="form-control" min="0" required />
                <span asp-validation-for="Quantity" class="text-danger small"></span>
            </div>
            <div class="col-md-4">
                <label class="form-label">Unit *</label>
                <select asp-for="Unit" class="form-select">
                    @foreach (var u in units.Union(new[] { Model.Unit }).Where(u => !string.IsNullOrEmpty(u)).Distinct())
                    {
                        <option value="@u">@u</option>
                    }
                </select>
            </div>
            <div class="col-md-4">
                <label class="form-label">Minimum / re-order level</label>
                <input asp-for="MinimumLevel" type="number" step="0.01" class="form-control" min="0" />
                <span asp-validation-for="MinimumLevel" class="text-danger small"></span>
            </div>
            <div class="col-md-4">
                <label class="form-label">Unit cost (৳)</label>
                <input asp-for="UnitCost" type="number" step="0.01" class="form-control" min="0" />
                <span asp-validation-for="UnitCost" class="text-danger small"></span>
            </div>
            <div class="col-md-4">
                <label class="form-label">Expiry date</label>
                <input asp-for="ExpiryDate" type="date" class="form-control" asp-format="{0:yyyy-MM-dd}" />
            </div>
            <div class="col-12">
                <label class="form-label">Preferred supplier</label>
                <select asp-for="SupplierId" class="form-select">
                    <option value="">-- No supplier --</option>
                    @foreach (var s in suppliers)
                    {
                        <option value="@s.Id">@s.Name (@s.Category)</option>
                    }
                </select>
            </div>
        </div>
        <div class="d-flex gap-2 mt-4">
            <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i>@(isNew ? "Add item" : "Save changes")</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
            @if (!isNew)
            {
                <a asp-action="Ledger" asp-route-itemId="@Model.Id" class="btn btn-link ms-auto"><i class="bi bi-journal-text me-1"></i>View ledger</a>
            }
        </div>
    </form>
</div>
</div></div>
