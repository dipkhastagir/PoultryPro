@model DiseaseCase
@using PoultryPro.Controllers
@{
    string? returnUrl = ViewBag.ReturnUrl as string;
    var backUrl = !string.IsNullOrEmpty(returnUrl) && Url.IsLocalUrl(returnUrl) ? returnUrl : Url.Action("Index", "Health");
    var statuses = HealthController.CaseStatuses;
}

<div class="page-head">
    <div>
        <h4><i class="bi bi-virus text-danger me-2"></i>Update Disease Case</h4>
        <p>@Model.DiseaseName · flock <span class="mono">@Model.BatchCode</span> · @Model.FarmName · reported @Fmt.Date(Model.ReportedDate)</p>
    </div>
    <div class="d-flex gap-2">
        <a href="@backUrl" class="btn btn-sm btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i>Back</a>
    </div>
</div>

<div class="stat-grid mb-4">
    <div class="stat-tile tone-amber">
        <div class="st-label">Affected</div>
        <div class="st-value">@Fmt.Num(Model.AffectedCount)</div>
        <div class="st-sub">birds showing signs</div>
        <div class="st-icon"><i class="bi bi-thermometer-half"></i></div>
    </div>
    <div class="stat-tile tone-red">
        <div class="st-label">Deaths</div>
        <div class="st-value">@Fmt.Num(Model.DeathCount)</div>
        <div class="st-sub">case fatality @Fmt.Pct(Model.CaseFatalityPct)</div>
        <div class="st-icon"><i class="bi bi-heartbreak"></i></div>
    </div>
    <div class="stat-tile tone-blue">
        <div class="st-label">Duration</div>
        <div class="st-value">@Model.DurationDays d</div>
        <div class="st-sub">@(Model.ResolvedDate.HasValue ? "resolved " + Fmt.Date(Model.ResolvedDate) : "still open")</div>
        <div class="st-icon"><i class="bi bi-hourglass-split"></i></div>
    </div>
    <div class="stat-tile tone-slate">
        <div class="st-label">Status</div>
        <div class="st-value fs-5"><span class="badge @Fmt.Badge(Model.Status)">@Model.Status</span></div>
        <div class="st-sub">diagnosed by @(Model.DiagnosedBy ?? "—")</div>
        <div class="st-icon"><i class="bi bi-clipboard2-pulse"></i></div>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-8">
        <div class="form-card">
            <form asp-action="EditDisease" asp-route-id="@Model.Id" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />
                <input type="hidden" name="returnUrl" value="@returnUrl" />
                <div class="row g-3">
                    <div class="col-md-4">
                        <label class="form-label">Status *</label>
                        <select asp-for="Status" class="form-select" id="caseStatus">
                            @foreach (var s in statuses) { <option value="@s">@s</option> }
                        </select>
                    </div>
                    <div class="col-md-4" id="resolvedWrap">
                        <label class="form-label">Resolved on</label>
                        <input asp-for="ResolvedDate" type="date" class="form-control" min="@Model.ReportedDate.ToString("yyyy-MM-dd")" max="@DateTime.Today.ToString("yyyy-MM-dd")" />
                        <div class="form-text">Defaults to today when left blank.</div>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Diagnosed by</label>
                        <input asp-for="DiagnosedBy" class="form-control" maxlength="100" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Affected birds</label>
                        <input asp-for="AffectedCount" type="number" min="0" class="form-control" id="affected" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Deaths attributed</label>
                        <input asp-for="DeathCount" type="number" min="0" class="form-control" id="deaths" />
                        <div class="form-text" id="cfrHint"></div>
                    </div>
                    <div class="col-12">
                        <label class="form-label">Treatment</label>
                        <textarea asp-for="Treatment" class="form-control" rows="3" placeholder="Drug, dose, route and duration — e.g. Enrofloxacin 10 mg/kg in water × 5 days"></textarea>
                    </div>
                    <div class="col-12">
                        <label class="form-label">Notes</label>
                        <textarea asp-for="Notes" class="form-control" rows="3" placeholder="Lab results, post-mortem findings, withdrawal period…"></textarea>
                    </div>
                </div>
                <div class="d-flex gap-2 mt-4">
                    <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i>Save update</button>
                    <a href="@backUrl" class="btn btn-outline-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="card mb-3">
            <div class="card-header"><h6><i class="bi bi-info-circle text-primary me-2"></i>Case</h6></div>
            <div class="card-body">
                <dl class="kv mb-0">
                    <dt>Disease</dt><dd>@Model.DiseaseName</dd>
                    <dt>Flock</dt><dd><a asp-controller="Batch" asp-action="Detail" asp-route-id="@Model.BatchId" class="mono">@Model.BatchCode</a></dd>
                    <dt>Farm</dt><dd>@Model.FarmName</dd>
                    <dt>Reported</dt><dd>@Fmt.Date(Model.ReportedDate)</dd>
                    <dt>Logged</dt><dd>@Fmt.DateTime(Model.CreatedAt)</dd>
                </dl>
            </div>
        </div>
        <a asp-controller="DiseaseLibrary" asp-action="Index" asp-route-q="@Model.DiseaseName" class="btn btn-sm btn-outline-primary w-100 mb-3">
            <i class="bi bi-journal-medical me-1"></i>Look up @Model.DiseaseName in the disease library
        </a>
        <div class="warn-callout small">
            <i class="bi bi-exclamation-triangle me-1"></i>Deaths cannot exceed affected birds. Record mortality in the daily
            record as well so flock livability stays accurate.
        </div>
    </div>
</div>

@section Scripts {
<script>
(function () {
    const a = document.getElementById('affected'), d = document.getElementById('deaths'), h = document.getElementById('cfrHint');
    const st = document.getElementById('caseStatus'), rw = document.getElementById('resolvedWrap');
    function cfr() {
        const av = +a.value || 0, dv = +d.value || 0;
        if (av > 0 && dv > av) { h.textContent = 'Deaths exceed affected birds.'; h.className = 'form-text text-danger'; }
        else { h.textContent = av > 0 ? 'Case fatality ' + (dv * 100 / av).toFixed(1) + '%' : ''; h.className = 'form-text'; }
    }
    function res() { rw.style.display = st.value === 'Resolved' ? '' : 'none'; }
    a.addEventListener('input', cfr); d.addEventListener('input', cfr); st.addEventListener('change', res);
    cfr(); res();
})();
</script>
}
