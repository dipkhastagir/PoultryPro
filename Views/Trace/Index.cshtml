@model List<TraceBatchRow>
@{
    string? q = ViewBag.Q; string? status = ViewBag.Status;
    string publicBase = ViewBag.PublicBase ?? "/Trace/Public/";
    var active = Model.Count(b => b.IsActive);
    var closed = Model.Count - active;
    var vaxDone = Model.Sum(b => b.VaxDone);
    var vaxTotal = Model.Sum(b => b.VaxTotal);
    var withOrders = Model.Count(b => b.OrderCount > 0);
}

@section Head {
<style>
    .qr-thumb { width: 72px; height: 72px; padding: 4px; background: #fff; border: 1px solid var(--border); border-radius: 8px; flex-shrink: 0; }
    .qr-thumb img, .qr-thumb canvas { width: 100% !important; height: 100% !important; }
    .trace-card { transition: box-shadow .15s ease; }
    .trace-card:hover { box-shadow: 0 6px 18px rgba(15, 23, 42, .08); }
</style>
}

<div class="page-head">
    <div>
        <h4>Traceability</h4>
        <p>Every flock gets a public farm-to-fork page — print the QR code on crates, labels or invoices so buyers can verify origin.</p>
    </div>
</div>

<div class="stat-grid">
    <div class="stat-tile tone-green">
        <div class="st-label">Traceable flocks</div>
        <div class="st-value">@Model.Count</div>
        <div class="st-sub">@active active · @closed closed</div>
        <div class="st-icon"><i class="bi bi-qr-code"></i></div>
    </div>
    <div class="stat-tile tone-blue">
        <div class="st-label">Vaccinations recorded</div>
        <div class="st-value">@vaxDone <span class="text-xs text-muted">/ @vaxTotal</span></div>
        <div class="st-sub">@(vaxTotal > 0 ? Fmt.Pct((decimal)vaxDone / vaxTotal * 100, 0) + " of scheduled doses done" : "no schedules yet")</div>
        <div class="st-icon"><i class="bi bi-shield-check"></i></div>
    </div>
    <div class="stat-tile tone-violet">
        <div class="st-label">Linked to sales</div>
        <div class="st-value">@withOrders</div>
        <div class="st-sub">flocks with at least one sales order</div>
        <div class="st-icon"><i class="bi bi-cart-check"></i></div>
    </div>
    <div class="stat-tile tone-slate">
        <div class="st-label">Verification</div>
        <div class="st-value" style="font-size:18px">SHA-256</div>
        <div class="st-sub">tamper-evident hash on every public page</div>
        <div class="st-icon"><i class="bi bi-fingerprint"></i></div>
    </div>
</div>

<form method="get" class="filter-bar">
    <div>
        <label class="form-label">Search</label>
        <input name="q" value="@q" class="form-control" placeholder="Batch code, breed or farm" />
    </div>
    <div>
        <label class="form-label">Status</label>
        <select name="status" class="form-select" onchange="this.form.submit()">
            <option value="" selected="@(string.IsNullOrEmpty(status))">All flocks</option>
            <option value="active" selected="@(status == "active")">Active</option>
            <option value="closed" selected="@(status == "closed")">Closed / harvested</option>
        </select>
    </div>
    <button class="btn btn-sm btn-primary"><i class="bi bi-search me-1"></i>Filter</button>
    @if (!string.IsNullOrEmpty(q) || !string.IsNullOrEmpty(status))
    {
        <a asp-action="Index" class="btn btn-sm btn-outline-secondary">Clear</a>
    }
</form>

@if (Model.Count == 0)
{
    <div class="card">
        <div class="empty-state">
            <i class="bi bi-qr-code-scan"></i>
            @(string.IsNullOrEmpty(q) && string.IsNullOrEmpty(status) ? "No batches yet — place a flock to start its traceability record." : "No flocks match your filter.")
            @if (string.IsNullOrEmpty(q) && string.IsNullOrEmpty(status))
            {
                <div class="mt-2"><a asp-controller="Batch" asp-action="Index" class="btn btn-sm btn-outline-primary">Go to batches</a></div>
            }
        </div>
    </div>
}
else
{
    <div class="row g-3">
        @foreach (var b in Model)
        {
            var url = publicBase.TrimEnd('/') + "/" + Uri.EscapeDataString(b.BatchCode);
            var vaxPct = b.VaxTotal > 0 ? (int)Math.Round(100.0 * b.VaxDone / b.VaxTotal) : 0;
            <div class="col-md-6 col-xxl-4">
                <div class="card trace-card h-100">
                    <div class="card-body d-flex gap-3">
                        <a href="@url" target="_blank" rel="noopener" class="qr-thumb" data-qr="@url" title="Open public page"></a>
                        <div class="flex-grow-1 min-w-0">
                            <div class="d-flex justify-content-between align-items-start gap-2">
                                <a asp-action="Timeline" asp-route-id="@b.Id" class="fw-600 text-decoration-none">@b.BatchCode</a>
                                <span class="badge @(b.IsActive ? "badge-healthy" : "badge-info-soft")">@(b.IsActive ? "Active" : "Harvested")</span>
                            </div>
                            <div class="text-xs text-muted text-truncate">@b.Breed · @b.BatchType · @b.FarmName</div>
                            <div class="text-xs text-muted">
                                Placed @Fmt.Date(b.PlacementDate)
                                @if (b.ClosedDate.HasValue) { <span>→ closed @Fmt.Date(b.ClosedDate)</span> } else { <span>· day @b.AgeInDays</span> }
                            </div>
                            <div class="d-flex align-items-center gap-2 mt-2 text-xs">
                                <i class="bi bi-shield-check text-primary"></i>
                                <div class="prog-bar-wrap flex-grow-1" style="height:6px"><div class="prog-bar-fill @(vaxPct < 50 && b.VaxTotal > 0 ? "warning" : "")" style="width:@vaxPct%"></div></div>
                                <span>@b.VaxDone/@b.VaxTotal vax</span>
                            </div>
                            <div class="d-flex flex-wrap gap-1 mt-2">
                                <span class="chip"><i class="bi bi-people"></i>@Fmt.Num(b.IsActive ? b.CurrentCount : b.InitialCount) @(b.IsActive ? "birds" : "placed")</span>
                                @if (b.OrderCount > 0) { <span class="chip"><i class="bi bi-cart"></i>@b.OrderCount order(s)</span> }
                            </div>
                        </div>
                    </div>
                    <div class="card-body border-top py-2 d-flex gap-2">
                        <a asp-action="Timeline" asp-route-id="@b.Id" class="btn btn-xs btn-outline-primary"><i class="bi bi-clock-history me-1"></i>Timeline</a>
                        <a href="@url" target="_blank" rel="noopener" class="btn btn-xs btn-outline-secondary"><i class="bi bi-box-arrow-up-right me-1"></i>Public page</a>
                        <a asp-controller="Batch" asp-action="Detail" asp-route-id="@b.Id" class="btn btn-xs btn-outline-secondary ms-auto"><i class="bi bi-collection me-1"></i>Batch</a>
                    </div>
                </div>
            </div>
        }
    </div>
}

@section Scripts {
<script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
<script>
document.querySelectorAll('[data-qr]').forEach(function (el) {
    if (typeof QRCode === 'undefined') { el.innerHTML = '<i class="bi bi-qr-code" style="font-size:52px;color:#94a3b8"></i>'; return; }
    new QRCode(el, { text: el.getAttribute('data-qr'), width: 128, height: 128, correctLevel: QRCode.CorrectLevel.M });
    el.removeAttribute('title');
});
</script>
}
