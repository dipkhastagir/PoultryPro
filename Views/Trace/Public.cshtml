@model TracePublicVm
@{
    // Public consumer page: anonymous visitors, so it must not use the signed-in _Layout.
    Layout = null;
    var m = Model;
    var gradeColor = m.BiosecurityGrade switch { "A" => "#0d9e75", "B" => "#3b82f6", "C" => "#f59e0b", null => "#94a3b8", _ => "#ef4444" };
    var gradeText = m.BiosecurityGrade switch
    {
        "A" => "Excellent biosecurity",
        "B" => "Good biosecurity",
        "C" => "Satisfactory biosecurity",
        null => "No audit on record",
        _ => "Improvement required"
    };
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex" />
    <title>@ViewData["Title"] — @m.CompanyName</title>
    <link rel="icon" href="~/img/favicon.svg" type="image/svg+xml" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.3/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-icons/1.11.3/font/bootstrap-icons.min.css" />
    <style>
        :root { --primary: #0d9e75; --primary-dark: #0a7d5e; --ink: #0f172a; --muted: #64748b; --line: #e2e8f0; --bg: #f1f5f9; }
        * { box-sizing: border-box; }
        body { margin: 0; background: var(--bg); color: var(--ink); font-family: 'Segoe UI', system-ui, -apple-system, sans-serif; font-size: 15px; }
        .tp-hero { background: radial-gradient(circle at 15% 15%, #134e4a 0%, #0f172a 65%); color: #e2e8f0; padding: 28px 16px 64px; }
        .tp-wrap { max-width: 760px; margin: 0 auto; }
        .tp-brand { display: flex; align-items: center; gap: 10px; font-weight: 700; color: #fff; }
        .tp-brand .ic { width: 36px; height: 36px; border-radius: 10px; background: var(--primary); display: flex; align-items: center; justify-content: center; font-size: 18px; color: #fff; }
        .tp-hero h1 { font-size: 26px; font-weight: 800; color: #fff; margin: 22px 0 6px; line-height: 1.2; }
        .tp-hero p { color: #94a3b8; margin: 0; }
        .tp-verified { display: inline-flex; align-items: center; gap: 6px; background: rgba(52, 211, 153, .15); color: #34d399; border: 1px solid rgba(52, 211, 153, .35); padding: 4px 12px; border-radius: 20px; font-size: 12.5px; font-weight: 600; margin-top: 14px; }
        .tp-body { margin-top: -40px; padding: 0 16px 32px; }
        .tp-card { background: #fff; border: 1px solid var(--line); border-radius: 14px; padding: 20px; margin-bottom: 16px; box-shadow: 0 4px 14px rgba(15, 23, 42, .05); }
        .tp-card h2 { font-size: 13px; text-transform: uppercase; letter-spacing: .06em; color: var(--muted); font-weight: 700; margin: 0 0 14px; display: flex; align-items: center; gap: 8px; }
        .tp-card h2 i { color: var(--primary); font-size: 16px; }
        .tp-facts { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 12px; }
        .tp-fact { background: #f8fafc; border-radius: 10px; padding: 10px 12px; }
        .tp-fact .l { font-size: 11.5px; color: var(--muted); text-transform: uppercase; letter-spacing: .03em; }
        .tp-fact .v { font-size: 16px; font-weight: 700; margin-top: 2px; }
        .tp-journey { display: flex; align-items: center; gap: 6px; flex-wrap: wrap; font-size: 13px; color: var(--muted); }
        .tp-journey .st { display: flex; align-items: center; gap: 6px; background: #f0fdf9; color: #065f46; border-radius: 20px; padding: 4px 10px; font-weight: 600; }
        .tp-vax { list-style: none; padding: 0; margin: 0; }
        .tp-vax li { display: flex; justify-content: space-between; gap: 10px; padding: 9px 0; border-bottom: 1px dashed var(--line); font-size: 14px; }
        .tp-vax li:last-child { border-bottom: 0; }
        .tp-ok { background: #f0fdf9; border: 1px solid #a7f3d0; color: #065f46; border-radius: 10px; padding: 12px 14px; display: flex; gap: 10px; }
        .tp-warn { background: #fffbeb; border: 1px solid #fde68a; color: #92400e; border-radius: 10px; padding: 12px 14px; display: flex; gap: 10px; }
        .tp-grade { width: 68px; height: 68px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 28px; font-weight: 800; color: #fff; flex-shrink: 0; }
        .tp-hash { font-family: Consolas, 'Courier New', monospace; background: var(--ink); color: #e2e8f0; border-radius: 8px; padding: 10px 14px; font-size: 17px; letter-spacing: .14em; text-align: center; word-break: break-all; }
        .tp-chip { display: inline-flex; align-items: center; gap: 5px; padding: 4px 10px; border-radius: 20px; background: #f1f5f9; font-size: 12.5px; color: #334155; margin: 0 6px 6px 0; }
        .tp-foot { text-align: center; font-size: 12px; color: var(--muted); padding: 8px 16px 28px; }
        .tp-search { display: flex; gap: 8px; }
        @@media print { body { background: #fff; } .tp-hero { color: var(--ink); background: #fff; } .tp-hero h1, .tp-brand { color: var(--ink); } .no-print { display: none !important; } }
    </style>
</head>
<body>
    <header class="tp-hero">
        <div class="tp-wrap">
            <div class="tp-brand"><span class="ic"><i class="bi bi-egg-fried"></i></span>@m.CompanyName <span class="fw-normal" style="color:#94a3b8;font-size:13px">· Farm-to-fork traceability</span></div>
            @if (m.Found)
            {
                <h1>@m.Breed @m.BatchType chicken from @m.FarmName</h1>
                <p>Lot <b class="text-white">@m.BatchCode</b> · @m.FarmLocation@(string.IsNullOrEmpty(m.Zone) ? "" : ", " + m.Zone) · Bangladesh</p>
                @if (m.Seal.Status == TraceSealInfo.Changed)
                {
                    <span class="tp-verified" style="background:rgba(248,113,113,.15);color:#f87171;border-color:rgba(248,113,113,.4)"><i class="bi bi-exclamation-octagon-fill"></i>Record changed after sealing</span>
                }
                else
                {
                    <span class="tp-verified"><i class="bi bi-patch-check-fill"></i>@(m.Seal.Status == TraceSealInfo.Intact ? "Sealed & verified farm record" : "Verified farm record")</span>
                }
            }
            else
            {
                <h1>Check where your chicken comes from</h1>
                <p>Enter the lot code printed on the label or scan the QR code on the package.</p>
            }
        </div>
    </header>

    <main class="tp-body">
        <div class="tp-wrap">
            @if (!m.Found)
            {
                <div class="tp-card">
                    @if (!string.IsNullOrWhiteSpace(m.Code))
                    {
                        <div class="tp-warn mb-3"><i class="bi bi-exclamation-triangle-fill"></i><div>We could not find a lot with code <b>@m.Code</b>. Please check the code on the label and try again.</div></div>
                    }
                    <form method="get" action="@Url.Content("~/Trace/Public")" class="tp-search">
                        <input name="code" class="form-control" placeholder="Lot code, e.g. BR-2026-01" value="@m.Code" required maxlength="40" />
                        <button class="btn btn-success px-4" style="background:var(--primary);border-color:var(--primary)"><i class="bi bi-search me-1"></i>Verify</button>
                    </form>
                </div>
            }
            else
            {
                <section class="tp-card">
                    <h2><i class="bi bi-signpost-split"></i>Journey</h2>
                    <div class="tp-journey mb-3">
                        <span class="st"><i class="bi bi-egg"></i>@(m.HatcheryName ?? "Hatchery")</span><i class="bi bi-chevron-right"></i>
                        <span class="st"><i class="bi bi-house-heart"></i>@m.FarmName</span><i class="bi bi-chevron-right"></i>
                        <span class="st" style="@(m.IsHarvested ? "" : "background:#f1f5f9;color:#64748b")"><i class="bi bi-flag"></i>@(m.IsHarvested ? "Harvested" : "Growing")</span><i class="bi bi-chevron-right"></i>
                        <span class="st" style="@(m.IsHarvested ? "" : "background:#f1f5f9;color:#64748b")"><i class="bi bi-basket2"></i>Your table</span>
                    </div>
                    <div class="tp-facts">
                        <div class="tp-fact"><div class="l">Breed</div><div class="v">@m.Breed</div></div>
                        <div class="tp-fact"><div class="l">Arrived at farm</div><div class="v">@Fmt.Date(m.PlacementDate)</div></div>
                        <div class="tp-fact"><div class="l">@(m.IsHarvested ? "Harvested" : "Status")</div><div class="v">@(m.IsHarvested ? Fmt.Date(m.HarvestDate) : "Still growing")</div></div>
                        <div class="tp-fact"><div class="l">@(m.IsHarvested ? "Age at harvest" : "Current age")</div><div class="v">@m.AgeAtHarvest days</div></div>
                        <div class="tp-fact"><div class="l">Average live weight</div><div class="v">@((m.AverageWeightKg).ToString("0.00")) kg</div></div>
                        <div class="tp-fact"><div class="l">Flock livability</div><div class="v">@Fmt.Pct(m.LivabilityPct)</div></div>
                    </div>
                </section>

                <section class="tp-card">
                    <h2><i class="bi bi-geo-alt"></i>Farm of origin</h2>
                    <div class="d-flex flex-wrap gap-2 align-items-center mb-2">
                        <span class="fw-bold fs-5">@m.FarmName</span>
                        @if (!string.IsNullOrEmpty(m.FarmType)) { <span class="tp-chip"><i class="bi bi-tag"></i>@m.FarmType farm</span> }
                    </div>
                    <div class="text-secondary"><i class="bi bi-pin-map me-1"></i>@m.FarmLocation@(string.IsNullOrEmpty(m.Zone) ? "" : " · " + m.Zone + " zone")</div>
                    @if (!string.IsNullOrEmpty(m.HatcheryName))
                    {
                        <div class="text-secondary mt-1"><i class="bi bi-egg me-1"></i>Day-old chicks supplied by @m.HatcheryName</div>
                    }
                    @if (m.Certifications.Count > 0)
                    {
                        <div class="mt-3">
                            @foreach (var c in m.Certifications) { <span class="tp-chip"><i class="bi bi-award text-success"></i>@c</span> }
                        </div>
                    }
                </section>

                <section class="tp-card">
                    <h2><i class="bi bi-shield-check"></i>Vaccination programme</h2>
                    @if (m.Vaccinations.Count == 0)
                    {
                        <div class="text-secondary">No vaccinations have been recorded for this lot yet.</div>
                    }
                    else
                    {
                        <ul class="tp-vax">
                            @foreach (var v in m.Vaccinations)
                            {
                                <li>
                                    <span><i class="bi bi-check-circle-fill text-success me-2"></i>@v.VaccineName@(string.IsNullOrEmpty(v.Route) ? "" : " · " + v.Route)</span>
                                    <span class="text-secondary text-nowrap">@Fmt.Date(v.CompletedDate)</span>
                                </li>
                            }
                        </ul>
                        <div class="text-secondary mt-2" style="font-size:13px">@m.Vaccinations.Count dose(s) administered and recorded by farm staff.</div>
                    }
                </section>

                <section class="tp-card">
                    <h2><i class="bi bi-capsule"></i>Medicine withdrawal</h2>
                    <div class="@(m.MedicineInWithdrawalWindow ? "tp-warn" : "tp-ok")">
                        <i class="bi @(m.MedicineInWithdrawalWindow ? "bi-hourglass-split" : "bi-check-circle-fill") fs-5"></i>
                        <div>@m.WithdrawalStatement</div>
                    </div>
                </section>

                <section class="tp-card">
                    <h2><i class="bi bi-shield-lock"></i>Biosecurity</h2>
                    <div class="d-flex align-items-center gap-3">
                        <div class="tp-grade" style="background:@gradeColor">@(m.BiosecurityGrade ?? "–")</div>
                        <div>
                            <div class="fw-bold">@gradeText</div>
                            @if (m.BiosecurityPct.HasValue)
                            {
                                <div class="text-secondary" style="font-size:13.5px">Audit score @Fmt.Pct(m.BiosecurityPct.Value) · audited @Fmt.Date(m.BiosecurityAuditDate)</div>
                            }
                            else
                            {
                                <div class="text-secondary" style="font-size:13.5px">The farm had not been audited before this lot was @(m.IsHarvested ? "harvested" : "checked").</div>
                            }
                        </div>
                    </div>
                </section>

                <section class="tp-card">
                    <h2><i class="bi bi-fingerprint"></i>Authenticity</h2>
                    <div class="tp-hash mb-2">@m.VerificationHash</div>
                    <div class="text-secondary" style="font-size:13px">
                        This code is a SHA-256 fingerprint of the farm's records for lot <b>@m.BatchCode</b>. It must match the code printed on your label or invoice —
                        if it does not, the product may not come from this flock.
                    </div>
                    <hr style="border-color:var(--line)" />
                    @if (m.Seal.Status == TraceSealInfo.Intact)
                    {
                        <div class="d-flex gap-2 align-items-start" style="font-size:13.5px;color:#0a7d5e">
                            <i class="bi bi-patch-check-fill" style="font-size:18px"></i>
                            <div><b>Record verified.</b> Sealed on @Fmt.DateTime(m.Seal.SealedAt) by @(m.Seal.SealedBy ?? "the farm"); record unchanged since sealing.</div>
                        </div>
                    }
                    else if (m.Seal.Status == TraceSealInfo.Changed)
                    {
                        <div class="d-flex gap-2 align-items-start" style="font-size:13.5px;color:#b91c1c">
                            <i class="bi bi-exclamation-octagon-fill" style="font-size:18px"></i>
                            <div><b>Record changed after sealing.</b> The farm sealed this record on @Fmt.DateTime(m.Seal.SealedAt), but its history has been modified since. Ask the seller for an explanation.</div>
                        </div>
                    }
                    else
                    {
                        <div class="d-flex gap-2 align-items-start text-secondary" style="font-size:13.5px">
                            <i class="bi bi-unlock" style="font-size:18px"></i>
                            <div><b>Not sealed yet.</b> The farm has not yet sealed this lot's record.</div>
                        </div>
                    }
                    <div class="text-secondary mt-3" style="font-size:12px">Record chain head (@m.ChainLength linked events, SHA-256)</div>
                    <div class="tp-hash" style="font-size:12px;letter-spacing:.04em">@m.Seal.ChainHead</div>
                </section>
            }
        </div>
    </main>

    <footer class="tp-foot">
        Generated @Fmt.DateTime(m.GeneratedAt) · Information supplied by @m.CompanyName from its farm management records.
        <div class="no-print mt-2"><a href="javascript:window.print()" class="text-secondary"><i class="bi bi-printer me-1"></i>Print this page</a></div>
    </footer>
</body>
</html>
