@model Batch
@{ ViewData["Title"] = $"Edit Batch {Model.BatchCode}"; }
<div class="row justify-content-center"><div class="col-lg-6">
<div class="form-card">
    <h6 class="fw-semibold mb-4"><i class="bi bi-feather2 text-success me-2"></i>Edit Batch @Model.BatchCode</h6>
    <form asp-action="Edit" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />
        <div class="row g-3">
            <div class="col-md-6">
                <label class="form-label">Current Count</label>
                <input asp-for="CurrentCount" type="number" class="form-control" />
            </div>
            <div class="col-md-6">
                <label class="form-label">Mortality Count</label>
                <input asp-for="MortalityCount" type="number" class="form-control" />
            </div>
            <div class="col-md-6">
                <label class="form-label">Average Weight (kg)</label>
                <input asp-for="AverageWeightKg" type="number" step="0.001" class="form-control" />
            </div>
            <div class="col-md-6">
                <label class="form-label">Total Feed (kg)</label>
                <input asp-for="TotalFeedKg" type="number" step="0.01" class="form-control" />
            </div>
            <div class="col-12">
                <label class="form-label">Health Status</label>
                <select asp-for="HealthStatus" class="form-select">
                    <option>Healthy</option><option>Vaccination Due</option>
                    <option>Under Treatment</option><option>Monitoring</option><option>Ready for Sale</option>
                </select>
            </div>
        </div>
        <div class="d-flex gap-2 mt-4">
            <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i>Update Batch</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
        </div>
    </form>
</div>
</div></div>
