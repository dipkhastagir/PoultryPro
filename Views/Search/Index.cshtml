@model SearchResultVm
@{
    var enc = System.Text.Encodings.Web.HtmlEncoder.Default;
    // HTML-encodes text and wraps every case-insensitive occurrence of the query in <mark>
    Microsoft.AspNetCore.Html.IHtmlContent Hi(string? text)
    {
        if (string.IsNullOrEmpty(text)) return Html.Raw("");
        if (string.IsNullOrEmpty(Model.Query)) return Html.Raw(enc.Encode(text));
        var sb = new System.Text.StringBuilder();
        int pos = 0;
        while (true)
        {
            var i = text.IndexOf(Model.Query, pos, StringComparison.OrdinalIgnoreCase);
            if (i < 0) break;
            sb.Append(enc.Encode(text.Substring(pos, i - pos)));
            sb.Append("<mark>").Append(enc.Encode(text.Substring(i, Model.Query.Length))).Append("</mark>");
            pos = i + Model.Query.Length;
        }
        sb.Append(enc.Encode(text.Substring(pos)));
        return Html.Raw(sb.ToString());
    }
    var suggestions = new[] { "Cobb", "Broiler", "Newcastle", "Feed", "Gazipur", "Layer" };
}

@section Head {
<style>
    .search-hero { max-width: 760px; }
    .search-hero .form-control { height: 46px; font-size: 15px; }
    .hit { display: flex; gap: 12px; align-items: center; padding: 10px 16px; border-bottom: 1px solid var(--border); color: inherit; text-decoration: none; }
    .hit:last-child { border-bottom: 0; }
    .hit:hover { background: #f8fafc; }
    .hit .hit-ic { width: 34px; height: 34px; border-radius: 9px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
    .hit mark { background: #fef08a; padding: 0 1px; border-radius: 2px; }
    .tone-bg-green { background: #e1f5ee; color: #0a7d5e; } .tone-bg-blue { background: #dbeafe; color: #1d4ed8; }
    .tone-bg-amber { background: #fef3c7; color: #b45309; } .tone-bg-violet { background: #ede9fe; color: #6d28d9; }
    .tone-bg-red { background: #fee2e2; color: #b91c1c; } .tone-bg-slate { background: #f1f5f9; color: #475569; }
</style>
}

<div class="page-head">
    <div>
        <h4>Search</h4>
        <p>
            @if (Model.Total > 0)
            {
                <span>@Model.Total result(s) in @Model.Groups.Count @(Model.Groups.Count == 1 ? "category" : "categories") for “@Model.Query”</span>
            }
            else
            {
                <span>Find flocks, farms, customers, suppliers, orders, staff, field officers, stock items and diseases</span>
            }
        </p>
    </div>
</div>

<form method="get" asp-action="Index" class="search-hero mb-4">
    <div class="input-group">
        <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
        <input name="q" value="@Model.Query" class="form-control" placeholder="Type at least 2 characters — batch code, farm, customer, order code, disease…" autofocus minlength="2" maxlength="100" />
        <button class="btn btn-primary px-4">Search</button>
    </div>
</form>

@if (string.IsNullOrEmpty(Model.Query) || Model.TooShort)
{
    <div class="card">
        <div class="empty-state">
            <i class="bi bi-search"></i>
            @(Model.TooShort ? "Please type at least 2 characters." : "Start typing to search the whole platform.")
            <div class="mt-3 d-flex flex-wrap gap-1 justify-content-center">
                @foreach (var s in suggestions)
                {
                    <a asp-action="Index" asp-route-q="@s" class="chip text-decoration-none">@s</a>
                }
            </div>
        </div>
    </div>
}
else if (Model.Total == 0)
{
    <div class="card">
        <div class="empty-state">
            <i class="bi bi-emoji-neutral"></i>
            No results for “@Model.Query”.
            <div class="text-xs mt-1">Check the spelling, try a shorter term (e.g. part of a batch code) or search by farm or breed name.</div>
        </div>
    </div>
}
else
{
    <div class="d-flex flex-wrap gap-1 mb-3">
        @foreach (var g in Model.Groups)
        {
            <a href="#grp-@g.Key" class="chip text-decoration-none"><i class="bi @g.Icon"></i>@g.Label <b>@g.Hits.Count</b></a>
        }
    </div>
    <div class="row g-4">
        @foreach (var g in Model.Groups)
        {
            <div class="col-xl-6" id="grp-@g.Key">
                <div class="card h-100">
                    <div class="card-header">
                        <h6><i class="bi @g.Icon text-primary me-2"></i>@g.Label</h6>
                        <span class="text-xs text-muted">@g.Hits.Count@(g.Hits.Count >= 10 ? "+ (top 10)" : "") match(es)</span>
                    </div>
                    <div>
                        @foreach (var h in g.Hits)
                        {
                            <a href="@Url.Content("~" + h.Url)" class="hit">
                                <span class="hit-ic tone-bg-@g.Tone"><i class="bi @g.Icon"></i></span>
                                <span class="flex-grow-1" style="min-width:0">
                                    <span class="d-block fw-600 text-truncate">@Hi(h.Title)</span>
                                    @if (!string.IsNullOrEmpty(h.Subtitle)) { <span class="d-block text-xs text-muted text-truncate">@Hi(h.Subtitle)</span> }
                                </span>
                                @if (!string.IsNullOrEmpty(h.Badge)) { <span class="badge @Fmt.Badge(h.Badge)">@h.Badge</span> }
                                <i class="bi bi-chevron-right text-muted"></i>
                            </a>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
}
