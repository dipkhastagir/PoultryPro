@model TrialFormVm
@{
    var t = Model.Trial;
    var active = Model.Batches.Where(b => b.IsActive).ToList();
    var closed = Model.Batches.Where(b => !b.IsActive).ToList();
}
<div class="row justify-content-center"><div class="col-xl-9">
<div class="form-card">
    @if (Model.IsEdit)
    {
        <a asp-action="Detail" asp-route-id="@t.Id" class="text-xs text-decoration-none"><i class="bi bi-arrow-left me-1"></i>Back to trial</a>
    }
    else
    {
        <a asp-action="Index" class="text-xs text-decoration-none"><i class="bi bi-arrow-left me-1"></i>All trials</a>
    }
    <h6 class="fw-semibold mb-1 mt-2"><i class="bi bi-clipboard2-pulse text-primary me-2"></i>@(Model.IsEdit ? "Edit trial " + t.TrialCode : "Register a field trial")</h6>
    <p class="text-muted small mb-4">Define the research question first; the analysis page compares the flocks automatically as daily records arrive.</p>

    @if (Model.Batches.Count < 2)
    {
        <div class="warn-callout mb-3">A trial needs at least two flocks. <a asp-controller="Batch" asp-action="Create">Create a batch</a> first.</div>
    }

    <form asp-action="@(Model.IsEdit ? "Edit" : "Create")" method="post" novalidate>
        <input type="hidden" asp-for="Trial.Id" />
        <input type="hidden" asp-for="Trial.Conclusion" />
        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>

        <div class="section-header"><span class="section-title">Identification</span></div>
        <div class="row g-3 mb-4">
            <div class="col-md-3">
                <label asp-for="Trial.TrialCode" class="form-label">Trial code *</label>
                <input asp-for="Trial.TrialCode" class="form-control mono" maxlength="30" />
                <span asp-validation-for="Trial.TrialCode" class="text-danger small"></span>
            </div>
            <div class="col-md-9">
                <label asp-for="Trial.Title" class="form-label">Title *</label>
                <input asp-for="Trial.Title" class="form-control" maxlength="200" placeholder="e.g. Effect of a Bacillus probiotic on broiler FCR" />
                <span asp-validation-for="Trial.Title" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Trial.PrincipalInvestigator" class="form-label">Principal investigator</label>
                <input asp-for="Trial.PrincipalInvestigator" class="form-control" maxlength="150" />
            </div>
            <div class="col-md-3">
                <label asp-for="Trial.StartDate" class="form-label">Start date *</label>
                <input asp-for="Trial.StartDate" type="date" class="form-control" />
                <span asp-validation-for="Trial.StartDate" class="text-danger small"></span>
            </div>
            <div class="col-md-3">
                <label asp-for="Trial.EndDate" class="form-label">End date</label>
                <input asp-for="Trial.EndDate" type="date" class="form-control" />
                <span asp-validation-for="Trial.EndDate" class="text-danger small"></span>
            </div>
        </div>

        <div class="section-header"><span class="section-title">Research question</span></div>
        <div class="row g-3 mb-4">
            <div class="col-12">
                <label asp-for="Trial.Objective" class="form-label">Objective</label>
                <textarea asp-for="Trial.Objective" class="form-control" rows="2" maxlength="1000" placeholder="What do you want to learn?"></textarea>
            </div>
            <div class="col-md-6">
                <label asp-for="Trial.Hypothesis" class="form-label">Hypothesis</label>
                <textarea asp-for="Trial.Hypothesis" class="form-control" rows="3" maxlength="1000" placeholder="e.g. The probiotic reduces FCR by at least 3%"></textarea>
                <div class="form-text">Include a number with “%” or “points” so the result can be checked automatically.</div>
            </div>
            <div class="col-md-6">
                <label asp-for="Trial.Intervention" class="form-label">Intervention (treatment)</label>
                <textarea asp-for="Trial.Intervention" class="form-control" rows="3" maxlength="1000" placeholder="Product, dose, timing — what differs from control"></textarea>
            </div>
            <div class="col-md-4">
                <label asp-for="Trial.PrimaryMetric" class="form-label">Primary metric *</label>
                <select asp-for="Trial.PrimaryMetric" class="form-select">
                    @foreach (var m in TrialFormVm.Metrics) { <option value="@m">@m</option> }
                </select>
                <span asp-validation-for="Trial.PrimaryMetric" class="text-danger small"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="Trial.Status" class="form-label">Status *</label>
                <select asp-for="Trial.Status" class="form-select">
                    @foreach (var s in TrialFormVm.Statuses) { <option value="@s">@s</option> }
                </select>
                <span asp-validation-for="Trial.Status" class="text-danger small"></span>
            </div>
        </div>

        <div class="section-header"><span class="section-title">Flocks</span></div>
        <div class="row g-3">
            <div class="col-md-6">
                <label asp-for="Trial.TreatmentBatchId" class="form-label"><i class="bi bi-circle-fill text-success me-1 small"></i>Treatment flock *</label>
                <select asp-for="Trial.TreatmentBatchId" class="form-select">
                    <option value="0">— choose —</option>
                    @if (active.Count > 0) { <optgroup label="Active">@foreach (var b in active) { <option value="@b.Id">@b.Label</option> }</optgroup> }
                    @if (closed.Count > 0) { <optgroup label="Closed">@foreach (var b in closed) { <option value="@b.Id">@b.Label</option> }</optgroup> }
                </select>
                <span asp-validation-for="Trial.TreatmentBatchId" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Trial.ControlBatchId" class="form-label"><i class="bi bi-circle-fill text-secondary me-1 small"></i>Control flock *</label>
                <select asp-for="Trial.ControlBatchId" class="form-select">
                    <option value="0">— choose —</option>
                    @if (active.Count > 0) { <optgroup label="Active">@foreach (var b in active) { <option value="@b.Id">@b.Label</option> }</optgroup> }
                    @if (closed.Count > 0) { <optgroup label="Closed">@foreach (var b in closed) { <option value="@b.Id">@b.Label</option> }</optgroup> }
                </select>
                <span asp-validation-for="Trial.ControlBatchId" class="text-danger small"></span>
            </div>
            <div class="col-12">
                <div class="info-callout text-xs mb-0" id="pairHint">Pick flocks of the same breed and similar placement date so that the intervention is the only systematic difference.</div>
            </div>
        </div>

        <div class="d-flex gap-2 mt-4">
            <button class="btn btn-primary"><i class="bi bi-check2 me-1"></i>@(Model.IsEdit ? "Save changes" : "Register trial")</button>
            @if (Model.IsEdit)
            {
                <a asp-action="Detail" asp-route-id="@t.Id" class="btn btn-outline-secondary">Cancel</a>
            }
            else
            {
                <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
            }
        </div>
    </form>
</div>
</div></div>

@section Scripts {
<script>
(function () {
    const info = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Batches.ToDictionary(b => b.Id.ToString(), b => new { b.Breed, b.AgeInDays, b.BatchCode })));
    const tSel = document.getElementById('Trial_TreatmentBatchId'), cSel = document.getElementById('Trial_ControlBatchId'), hint = document.getElementById('pairHint');
    const def = hint.innerHTML;
    function check() {
        const a = info[tSel.value], b = info[cSel.value];
        hint.className = 'info-callout text-xs mb-0';
        if (!a || !b) { hint.innerHTML = def; return; }
        if (tSel.value === cSel.value) { hint.className = 'warn-callout text-xs mb-0'; hint.textContent = 'Treatment and control must be different flocks.'; return; }
        const msgs = [];
        if (a.Breed !== b.Breed) msgs.push('different breeds (' + a.Breed + ' vs ' + b.Breed + ') — breed will confound the result');
        if (Math.abs(a.AgeInDays - b.AgeInDays) > 7) msgs.push('ages differ by ' + Math.abs(a.AgeInDays - b.AgeInDays) + ' days — seasonal effects may confound');
        if (msgs.length) { hint.className = 'warn-callout text-xs mb-0'; hint.textContent = 'Caution: ' + msgs.join('; ') + '.'; }
        else hint.textContent = 'Good match: same breed and similar age (' + a.BatchCode + ' vs ' + b.BatchCode + ').';
    }
    tSel.addEventListener('change', check); cSel.addEventListener('change', check); check();
})();
</script>
}
