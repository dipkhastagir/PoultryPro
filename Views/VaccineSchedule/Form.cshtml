@model VaccineTemplate
@{
    var types = ViewBag.BatchTypes as string[] ?? new[] { "Broiler", "Sonali", "Layer" };
    var isNew = Model.Id == 0;
}
<div class="row justify-content-center"><div class="col-lg-7">
<div class="form-card">
    <h6 class="fw-semibold mb-1"><i class="bi bi-eyedropper text-primary me-2"></i>@(isNew ? "New vaccine programme" : "Edit " + Model.Name)</h6>
    <p class="text-muted small mb-4">Name the programme and the flock type it is for. You will add individual vaccines and their ages on the next page.</p>
    <form asp-action="@(isNew ? "Create" : "Edit")" method="post" novalidate>
        <input type="hidden" asp-for="Id" />
        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>
        <div class="row g-3">
            <div class="col-md-8">
                <label class="form-label">Programme name *</label>
                <input asp-for="Name" class="form-control" required maxlength="150" placeholder="e.g. Broiler standard (35 days)" />
                <span asp-validation-for="Name" class="text-danger small"></span>
            </div>
            <div class="col-md-4">
                <label class="form-label">Flock type *</label>
                <select asp-for="BatchType" class="form-select">
                    @foreach (var t in types)
                    {
                        <option value="@t">@t</option>
                    }
                </select>
                <span asp-validation-for="BatchType" class="text-danger small"></span>
            </div>
            <div class="col-12">
                <label class="form-label">Description</label>
                <textarea asp-for="Description" class="form-control" rows="3" maxlength="500" placeholder="Source of the schedule, region, hatchery recommendations…"></textarea>
                <span asp-validation-for="Description" class="text-danger small"></span>
            </div>
            <div class="col-12">
                <div class="form-check form-switch">
                    <input class="form-check-input" type="checkbox" asp-for="IsActive" />
                    <label class="form-check-label" asp-for="IsActive">Active — offered when placing new flocks</label>
                </div>
            </div>
        </div>
        <div class="d-flex gap-2 mt-4">
            <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i>@(isNew ? "Create programme" : "Save changes")</button>
            @if (isNew)
            {
                <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
            }
            else
            {
                <a asp-action="Detail" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Cancel</a>
            }
        </div>
    </form>
</div>
</div></div>
