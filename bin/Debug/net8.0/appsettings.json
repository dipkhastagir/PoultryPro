{
  "ConnectionStrings": {
    // Default: the local SQL Server instance with Windows authentication.
    // SQL Server Express users:  "Server=.\\SQLEXPRESS;Database=PoultryProDB;Trusted_Connection=True;TrustServerCertificate=True;"
    // SQL login example:         "Server=localhost;Database=PoultryProDB;User Id=sa;Password=YourPassword;TrustServerCertificate=True;"
    // Previous remote connection (kept from the original project):
    // "Default": "Server=103.134.89.218;Database=PoultryProDB;User Id=sa;Password=manager;TrustServerCertificate=True;",
    "Default": "Server=localhost;Database=PoultryProDB;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=True;"
  },
  "Database": {
    // Creates the database, tables, views and reference data automatically on start-up.
    "AutoSetup": true,
    // Generates the demonstration data set when the database has no farms yet.
    "SeedDemoData": true,
    // If the server above cannot be reached, these instances are tried in order.
    "TryFallbackServers": true,
    "FallbackServers": [ ".\\SQLEXPRESS", "(localdb)\\MSSQLLocalDB", "." ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
